@model IEnumerable<AutomatedAccountedPayroll.Models.Attendance>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Attendance";

    var todayAttendance =
        ViewBag.TodayAttendance as AutomatedAccountedPayroll.Models.Attendance;
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-primary-subtle text-primary px-3 py-2">
                <i class="bi bi-calendar-check me-1"></i>
                Attendance
            </span>
        </div>

        <h2 class="fw-bold mb-1">My Attendance</h2>

        <p class="text-muted mb-0">
            View your attendance and manage today's check-in and check-out.
        </p>
    </div>


    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- TODAY'S ATTENDANCE -->
    <div class="row g-4 mb-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Today's Attendance
                            </h5>

                            <p class="text-muted mb-0">
                                @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                            </p>
                        </div>

                        <i class="bi bi-calendar-day fs-2 text-primary"></i>

                    </div>
                </div>


                <div class="card-body p-4">

                    @if (todayAttendance == null)
                    {
                        <div class="text-center py-4">

                            <div class="mb-3">
                                <i class="bi bi-clock-history display-4 text-muted"></i>
                            </div>

                            <h5 class="fw-bold">
                                You haven't checked in today
                            </h5>

                            <p class="text-muted">
                                Click the button below to record your check-in.
                            </p>
                            <button type="button"
                                    class="btn btn-primary px-4"
                                    data-bs-toggle="modal"
                                    data-bs-target="#checkInModal">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Check In
                            </button>

                            <form asp-action="CheckIn"
                                  method="post"
                                  id="checkInForm"
                                  class="d-none">

                                @Html.AntiForgeryToken()

                            </form>

                        </div>
                    }
                    else
                    {
                        <div class="row g-3">

                            <!-- CHECK IN -->
                            <div class="col-md-4">

                                <div class="p-3 rounded-3 bg-light">

                                    <small class="text-muted d-block mb-1">
                                        Check In
                                    </small>

                                    <h5 class="fw-bold mb-0">
                                        @(todayAttendance.CheckInTime?.ToString(@"hh\:mm\:ss") ?? "-")
                                    </h5>

                                </div>

                            </div>


                            <!-- CHECK OUT -->
                            <div class="col-md-4">

                                <div class="p-3 rounded-3 bg-light">

                                    <small class="text-muted d-block mb-1">
                                        Check Out
                                    </small>

                                    <h5 class="fw-bold mb-0">
                                        @(todayAttendance.CheckOutTime?.ToString(@"hh\:mm\:ss") ?? "-")
                                    </h5>

                                </div>

                            </div>


                            <!-- WORKING HOURS -->
                            <div class="col-md-4">

                                <div class="p-3 rounded-3 bg-light">

                                    <small class="text-muted d-block mb-1">
                                        Working Hours
                                    </small>

                                    <h5 class="fw-bold mb-0">
                                        @(todayAttendance.WorkingHours?.ToString("0.00") ?? "-")
                                    </h5>

                                </div>

                            </div>

                        </div>


                        <!-- ACTION -->
                        <div class="text-center mt-4">

                            @if (!todayAttendance.CheckOutTime.HasValue)
                            {
                                                                                              <button type="button"
                                        class="btn btn-success px-4"
                                        data-bs-toggle="modal"
                                        data-bs-target="#checkOutModal">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Check Out
                                </button>

                                <form asp-action="CheckOut"
                                      method="post"
                                      id="checkOutForm"
                                      class="d-none">

                                    @Html.AntiForgeryToken()

                                </form>
                            }
                            else
                            {
                                <div class="alert alert-success mb-0">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Your attendance for today is complete.
                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- STATUS CARD -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Today's Status
                    </h5>

                    @if (todayAttendance == null)
                    {
                        <div class="text-center py-3">

                            <i class="bi bi-hourglass-split display-5 text-warning"></i>

                            <h6 class="fw-bold mt-3">
                                Not Checked In
                            </h6>

                            <p class="text-muted small mb-0">
                                Your attendance has not been marked today.
                            </p>

                        </div>
                    }
                    else if (!todayAttendance.CheckOutTime.HasValue)
                    {
                        <div class="text-center py-3">

                            <i class="bi bi-person-check display-5 text-primary"></i>

                            <h6 class="fw-bold mt-3">
                                Currently Working
                            </h6>

                            <p class="text-muted small mb-0">
                                You are checked in and have not checked out yet.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">

                            <i class="bi bi-check-circle display-5 text-success"></i>

                            <h6 class="fw-bold mt-3">
                                Attendance Complete
                            </h6>

                            <p class="text-muted small mb-0">
                                Your check-in and check-out have been recorded.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ATTENDANCE HISTORY -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">

            <h5 class="fw-bold mb-1">
                Attendance History
            </h5>

            <p class="text-muted mb-0">
                Your recorded attendance history.
            </p>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="px-4">Date</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Working Hours</th>
                                <th>Late</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var attendance in Model)
                            {
                                var statusClass =
                                    attendance.Status switch
                                    {
                                        "Present" => "bg-success",
                                        "Absent" => "bg-danger",
                                        "Late" => "bg-warning text-dark",
                                        "Leave" => "bg-info text-dark",
                                        "Half Day" => "bg-secondary",
                                        _ => "bg-light text-dark"
                                    };

                                <tr>

                                    <td class="px-4 fw-semibold">
                                        @attendance.AttendanceDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(attendance.CheckInTime?.ToString(@"hh\:mm\:ss") ?? "-")
                                    </td>

                                    <td>
                                        @(attendance.CheckOutTime?.ToString(@"hh\:mm\:ss") ?? "-")
                                    </td>

                                    <td>
                                        @(attendance.WorkingHours?.ToString("0.00") ?? "-")
                                    </td>

                                    <td>
                                        @attendance.LateMinutes min
                                    </td>

                                    <td>
                                        <span class="badge @statusClass">
                                            @attendance.Status
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-5 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No Attendance Records
                    </h5>

                    <p class="text-muted mb-0">
                        Your attendance history will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

    <!-- CHECK IN MODAL -->
<div class="modal fade" id="checkInModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-2 text-primary"></i>
                    Confirm Check In
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to Check In now?
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary" id="confirmCheckIn">
                    <i class="bi bi-check-lg me-1"></i>
                    Yes, Check In
                </button>
            </div>
        </div>
    </div>
</div>

<!-- CHECK OUT MODAL -->
<div class="modal fade" id="checkOutModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-semibold">
                    <i class="bi bi-box-arrow-right me-2 text-success"></i>
                    Confirm Check Out
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to Check Out now?
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-success" id="confirmCheckOut">
                    <i class="bi bi-check-lg me-1"></i>
                    Yes, Check Out
                </button>
            </div>
        </div>
    </div>
</div>
</div>






@section Scripts {
    <script>
        document.getElementById('confirmCheckIn')
            ?.addEventListener('click', function () {
                this.disabled = true;
                this.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
                document.getElementById('checkInForm').submit();
            });

        document.getElementById('confirmCheckOut')
            ?.addEventListener('click', function () {
                this.disabled = true;
                this.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
                document.getElementById('checkOutForm').submit();
            });
    </script>
}
