@{
    ViewData["Title"] = "Employee Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Account - Automated Accounted Payroll</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .notice-wrapper {
            width: 100%;
            max-width: 480px;
            padding: 24px;
        }

        .notice-card {
            border: 0;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(15, 23, 42, 0.08);
        }
    </style>
</head>

<body>

    <div class="notice-wrapper">

        <div class="text-center mb-4">

            <div class="d-inline-flex align-items-center justify-content-center
                        rounded-circle bg-primary bg-opacity-10 text-primary mb-3"
                 style="width:72px;height:72px;">

                <i class="bi bi-building fs-2"></i>

            </div>

            <h2 class="fw-bold mb-1">
                Accounted
            </h2>

            <p class="text-muted mb-0">
                Payroll Management System
            </p>

        </div>


        <div class="card notice-card">

            <div class="card-body p-4 p-md-5 text-center">

                <div class="d-inline-flex align-items-center justify-content-center
                            rounded-circle bg-warning bg-opacity-10 text-warning mb-3"
                     style="width:64px;height:64px;">

                    <i class="bi bi-person-exclamation fs-2"></i>

                </div>

                <h4 class="fw-bold mb-2">
                    Employee Profile Not Found
                </h4>

                <p class="text-muted mb-4">
                    Your login account is not currently linked to an
                    active employee. Please contact the administrator.
                </p>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                      method="post"
                      class="d-inline">

                    <button type="submit"
                            class="btn btn-outline-secondary px-4">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Sign out

                    </button>

                </form>

            </div>

        </div>


        <p class="text-center text-muted small mt-4 mb-0">
            © 2026 Automated Accounted Payroll
        </p>

    </div>

</body>
</html>