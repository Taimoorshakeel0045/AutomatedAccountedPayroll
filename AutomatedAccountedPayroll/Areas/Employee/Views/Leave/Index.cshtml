@model IEnumerable<AutomatedAccountedPayroll.Models.Leave>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Leaves";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                My Leaves
            </h2>

            <p class="text-muted mb-0">
                View your leave requests and their current status.
            </p>
        </div>

              <div class="d-flex gap-2">

            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Apply for Leave
            </a>

            <span class="badge bg-primary-subtle text-primary px-3 py-2 align-self-center">
                <i class="bi bi-calendar2-check me-1"></i>
                Leave History
            </span>

        </div>

    </div>


    <!-- SUMMARY -->
    <div class="row g-4 mb-4">

        @{
            var totalLeaves = Model.Count();
            var pendingLeaves = Model.Count(l => l.Status == "Pending");
            var approvedLeaves = Model.Count(l => l.Status == "Approved");
            var rejectedLeaves = Model.Count(l => l.Status == "Rejected");
        }

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Total Requests
                    </div>

                    <div class="fs-3 fw-bold">
                        @totalLeaves
                    </div>

                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Pending
                    </div>

                    <div class="fs-3 fw-bold text-warning">
                        @pendingLeaves
                    </div>

                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Approved
                    </div>

                    <div class="fs-3 fw-bold text-success">
                        @approvedLeaves
                    </div>

                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Rejected
                    </div>

                    <div class="fs-3 fw-bold text-danger">
                        @rejectedLeaves
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- LEAVE HISTORY -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center">

                <div class="bg-primary-subtle text-primary rounded-3 p-2 me-3">
                    <i class="bi bi-calendar2-week fs-5"></i>
                </div>

                <div>
                    <h5 class="mb-1 fw-semibold">
                        Leave History
                    </h5>

                    <small class="text-muted">
                        Your submitted and processed leave requests.
                    </small>
                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    </div>

                    <h5 class="fw-semibold">
                        No Leave Records
                    </h5>

                    <p class="text-muted mb-0">
                        You currently have no leave requests.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Leave Type
                                </th>

                                <th>
                                    Start Date
                                </th>

                                <th>
                                    End Date
                                </th>

                                <th>
                                    Days
                                </th>

                                <th>
                                    Reason
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var leave in Model)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <span class="fw-semibold">
                                            @leave.LeaveType
                                        </span>
                                    </td>


                                    <td>
                                        @leave.StartDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @leave.EndDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        <span class="fw-semibold">
                                            @leave.TotalDays.ToString("0.##")
                                        </span>
                                    </td>


                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(leave.Reason))
                                        {
                                            <span>
                                                @leave.Reason
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                    </td>


                                    <td>

                                        @if (leave.Status == "Approved")
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Approved
                                            </span>
                                        }
                                        else if (leave.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                @leave.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>