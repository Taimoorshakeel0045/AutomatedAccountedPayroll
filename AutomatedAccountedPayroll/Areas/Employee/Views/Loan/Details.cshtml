@model AutomatedAccountedPayroll.Models.Loan

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Loan Details";

    var payments = ViewBag.Payments
        as IEnumerable<AutomatedAccountedPayroll.Models.LoanPayment>
        ?? Enumerable.Empty<AutomatedAccountedPayroll.Models.LoanPayment>();

    var totalPaid = ViewBag.TotalPaid is decimal
        ? (decimal)ViewBag.TotalPaid
        : 0;

    var paymentCount = ViewBag.PaymentCount is int
        ? (int)ViewBag.PaymentCount
        : 0;

    decimal progress = Model.LoanAmount > 0
        ? (totalPaid / Model.LoanAmount) * 100
        : 0;

    progress = Math.Max(0, Math.Min(100, progress));
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Loan Details
            </h2>

            <p class="text-muted mb-0">
                View your loan information and payment history.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to My Loans
            </a>
        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <!-- LOAN AMOUNT -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Loan Amount
                    </div>

                    <div class="fs-4 fw-bold">
                        Rs. @Model.LoanAmount.ToString("N0")
                    </div>

                    <small class="text-muted">
                        Original amount
                    </small>

                </div>

            </div>
        </div>


        <!-- TOTAL PAID -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Total Paid
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        Rs. @totalPaid.ToString("N0")
                    </div>

                    <small class="text-muted">
                        Amount paid so far
                    </small>

                </div>

            </div>
        </div>


        <!-- REMAINING -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Remaining Balance
                    </div>

                    <div class="fs-4 fw-bold
                        @(Model.RemainingBalance > 0
                            ? "text-danger"
                            : "text-success")">

                        Rs. @Model.RemainingBalance.ToString("N0")

                    </div>

                    <small class="text-muted">
                        Outstanding amount
                    </small>

                </div>

            </div>
        </div>


        <!-- PAYMENTS -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Payments Made
                    </div>

                    <div class="fs-4 fw-bold">
                        @paymentCount
                    </div>

                    <small class="text-muted">
                        Recorded payments
                    </small>

                </div>

            </div>
        </div>

    </div>


    <!-- PAYMENT PROGRESS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Loan Repayment Progress
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        @progress.ToString("0")%
                    </div>

                    <small class="text-muted">
                        @if (Model.RemainingBalance <= 0)
                        {
                            @:Loan fully paid
                        }
                        else
                        {
                            @:Amount paid toward original loan
                        }
                    </small>

                </div>


                <div class="col-md-8">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="small text-muted">
                            Paid
                        </span>

                        <span class="small fw-semibold">
                            Rs. @totalPaid.ToString("N0")
                            / Rs. @Model.LoanAmount.ToString("N0")
                        </span>

                    </div>

                    <div class="progress"
                         style="height: 10px;">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @progress.ToString("0.##")%;"
                             aria-valuenow="@progress.ToString("0.##")"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- MAIN CONTENT -->
    <div class="row g-4">

        <!-- LOAN INFORMATION -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-primary-subtle text-primary rounded-3 p-2 me-3">
                            <i class="bi bi-wallet2 fs-5"></i>
                        </div>

                        <div>

                            <h5 class="mb-1 fw-semibold">
                                Loan Information
                            </h5>

                            <small class="text-muted">
                                Details of your loan
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body">

                    <!-- LOAN AMOUNT -->
                    <div class="mb-3">

                        <div class="text-muted small">
                            Loan Amount
                        </div>

                        <div class="fw-semibold">
                            Rs. @Model.LoanAmount.ToString("N2")
                        </div>

                    </div>


                    <!-- MONTHLY INSTALLMENT -->
                    <div class="mb-3">

                        <div class="text-muted small">
                            Monthly Installment
                        </div>

                        <div class="fw-semibold">
                            Rs. @Model.MonthlyInstallment.ToString("N2")
                        </div>

                    </div>


                    <!-- START DATE -->
                    <div class="mb-3">

                        <div class="text-muted small">
                            Start Date
                        </div>

                        <div class="fw-semibold">
                            @Model.StartDate.ToString("dd MMM yyyy")
                        </div>

                    </div>


                    <!-- REMAINING BALANCE -->
                    <div class="mb-3">

                        <div class="text-muted small">
                            Remaining Balance
                        </div>

                        <div class="fw-semibold
                            @(Model.RemainingBalance > 0
                                ? "text-danger"
                                : "text-success")">

                            Rs. @Model.RemainingBalance.ToString("N2")

                        </div>

                    </div>


                    <!-- STATUS -->
                    <div class="mb-3">

                        <div class="text-muted small">
                            Status
                        </div>

                        <div class="mt-1">

                            @if (Model.Status.Equals(
                                "Active",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-primary-subtle text-primary">

                                    <i class="bi bi-clock-history me-1"></i>

                                    Active

                                </span>
                            }
                            else if (Model.Status.Equals(
                                "Completed",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success-subtle text-success">

                                    <i class="bi bi-check-circle me-1"></i>

                                    Completed

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">

                                    @Model.Status

                                </span>
                            }

                        </div>

                    </div>


                    <!-- REMARKS -->
                    <div>

                        <div class="text-muted small">
                            Remarks
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                        {
                            <div class="fw-semibold">
                                @Model.Remarks
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                No remarks
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- PAYMENT HISTORY -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-success-subtle text-success rounded-3 p-2 me-3">
                            <i class="bi bi-clock-history fs-5"></i>
                        </div>

                        <div>

                            <h5 class="mb-1 fw-semibold">
                                Payment History
                            </h5>

                            <small class="text-muted">
                                Payments made against this loan.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body p-0">

                    @if (!payments.Any())
                    {
                        <div class="text-center py-5">

                            <div class="mb-3">
                                <i class="bi bi-receipt fs-1 text-muted"></i>
                            </div>

                            <h5 class="fw-semibold">
                                No Payments Yet
                            </h5>

                            <p class="text-muted mb-0">
                                No payments have been recorded for this loan.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th class="ps-4">
                                            Payment Date
                                        </th>

                                        <th>
                                            Amount
                                        </th>

                                        <th>
                                            Method
                                        </th>

                                        <th>
                                            Remaining
                                        </th>

                                        <th>
                                            Remarks
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var payment in payments)
                                    {
                                        <tr>

                                            <!-- PAYMENT DATE -->
                                            <td class="ps-4">

                                                <span class="fw-semibold">
                                                    @payment.PaymentDate.ToString("dd MMM yyyy")
                                                </span>

                                            </td>


                                            <!-- AMOUNT -->
                                            <td>

                                                <span class="fw-semibold text-success">
                                                    Rs. @payment.PaymentAmount.ToString("N0")
                                                </span>

                                            </td>


                                            <!-- METHOD -->
                                            <td>

                                                @payment.PaymentMethod

                                            </td>


                                            <!-- REMAINING -->
                                            <td>

                                                <span class="fw-semibold">
                                                    Rs. @payment.RemainingBalance.ToString("N0")
                                                </span>

                                            </td>


                                            <!-- REMARKS -->
                                            <td>

                                                @if (!string.IsNullOrWhiteSpace(payment.Remarks))
                                                {
                                                    <span>
                                                        @payment.Remarks
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        -
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>