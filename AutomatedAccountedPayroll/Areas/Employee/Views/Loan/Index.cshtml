@model IEnumerable<AutomatedAccountedPayroll.Models.Loan>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Loans";

    var loans = Model.ToList();

    var totalLoans = loans.Count;

    var activeLoans = loans.Count(x =>
        x.Status.Equals("Active", StringComparison.OrdinalIgnoreCase));

    var totalBorrowed = loans.Sum(x => x.LoanAmount);

    var totalRemaining = loans.Sum(x => x.RemainingBalance);

    var totalPaid = totalBorrowed - totalRemaining;

    if (totalPaid < 0)
    {
        totalPaid = 0;
    }
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                My Loans
            </h2>

            <p class="text-muted mb-0">
                View your loans, installments and remaining balances.
            </p>
        </div>

               <div class="d-flex gap-2">

            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Apply for Loan
            </a>

            <span class="badge bg-primary-subtle text-primary px-3 py-2 align-self-center">
                <i class="bi bi-cash-coin me-1"></i>
                Loan Information
            </span>

        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <!-- TOTAL LOANS -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Total Loans
                    </div>

                    <div class="fs-3 fw-bold">
                        @totalLoans
                    </div>

                    <small class="text-muted">
                        All loan records
                    </small>

                </div>
            </div>
        </div>


        <!-- ACTIVE LOANS -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Active Loans
                    </div>

                    <div class="fs-3 fw-bold text-primary">
                        @activeLoans
                    </div>

                    <small class="text-muted">
                        Currently active
                    </small>

                </div>
            </div>
        </div>


        <!-- TOTAL BORROWED -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Total Borrowed
                    </div>

                    <div class="fs-3 fw-bold">
                        Rs. @totalBorrowed.ToString("N0")
                    </div>

                    <small class="text-muted">
                        Original loan amount
                    </small>

                </div>
            </div>
        </div>


        <!-- TOTAL REMAINING -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Remaining Balance
                    </div>

                    <div class="fs-3 fw-bold text-danger">
                        Rs. @totalRemaining.ToString("N0")
                    </div>

                    <small class="text-muted">
                        Amount still outstanding
                    </small>

                </div>
            </div>
        </div>

    </div>


    <!-- TOTAL PAID SUMMARY -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Total Amount Paid
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        Rs. @totalPaid.ToString("N0")
                    </div>

                    <small class="text-muted">
                        Across all your loans
                    </small>

                </div>


                <div class="col-md-8">

                    @{
                        decimal overallProgress = totalBorrowed > 0
                            ? (totalPaid / totalBorrowed) * 100
                            : 0;

                        overallProgress = Math.Max(
                            0,
                            Math.Min(100, overallProgress));
                    }

                    <div class="d-flex justify-content-between mb-2">

                        <span class="small text-muted">
                            Overall Loan Progress
                        </span>

                        <span class="small fw-semibold">
                            @overallProgress.ToString("0")%
                        </span>

                    </div>

                    <div class="progress" style="height: 10px;">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @overallProgress.ToString("0.##")%;"
                             aria-valuenow="@overallProgress.ToString("0.##")"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- LOAN TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center">

                <div class="bg-primary-subtle text-primary rounded-3 p-2 me-3">
                    <i class="bi bi-wallet2 fs-5"></i>
                </div>

                <div>

                    <h5 class="mb-1 fw-semibold">
                        My Loan History
                    </h5>

                    <small class="text-muted">
                        Your loan records, payment progress and current balances.
                    </small>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!loans.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-wallet2 fs-1 text-muted"></i>
                    </div>

                    <h5 class="fw-semibold">
                        No Loan Records
                    </h5>

                    <p class="text-muted mb-0">
                        You currently have no loan records.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Start Date
                                </th>

                                <th>
                                    Loan Amount
                                </th>

                                <th>
                                    Monthly Installment
                                </th>

                                <th>
                                    Remaining Balance
                                </th>

                                <th>
                                    Progress
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var loan in loans)
                            {
                                decimal loanPaid =
                                    loan.LoanAmount - loan.RemainingBalance;

                                if (loanPaid < 0)
                                {
                                    loanPaid = 0;
                                }

                                decimal progress =
                                    loan.LoanAmount > 0
                                        ? (loanPaid / loan.LoanAmount) * 100
                                        : 0;

                                progress = Math.Max(
                                    0,
                                    Math.Min(100, progress));

                                <tr>

                                    <!-- START DATE -->
                                    <td class="ps-4">

                                        <span class="fw-semibold">
                                            @loan.StartDate.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <!-- LOAN AMOUNT -->
                                    <td>

                                        <span class="fw-semibold">
                                            Rs. @loan.LoanAmount.ToString("N0")
                                        </span>

                                    </td>


                                    <!-- MONTHLY INSTALLMENT -->
                                    <td>

                                        Rs. @loan.MonthlyInstallment.ToString("N0")

                                    </td>


                                    <!-- REMAINING BALANCE -->
                                    <td>

                                        <span class="fw-semibold
                                            @(loan.RemainingBalance > 0
                                                ? "text-danger"
                                                : "text-success")">

                                            Rs. @loan.RemainingBalance.ToString("N0")

                                        </span>

                                    </td>


                                    <!-- PROGRESS -->
                                    <td style="min-width: 150px;">

                                        <div class="d-flex justify-content-between mb-1">

                                            <small class="text-muted">
                                                Paid
                                            </small>

                                            <small class="fw-semibold">
                                                @progress.ToString("0")%
                                            </small>

                                        </div>

                                        <div class="progress"
                                             style="height: 7px;">

                                            <div class="progress-bar bg-success"
                                                 role="progressbar"
                                                 style="width: @progress.ToString("0.##")%;"
                                                 aria-valuenow="@progress.ToString("0.##")"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                            </div>

                                        </div>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (loan.Status.Equals(
                                            "Active",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-primary-subtle text-primary">

                                                <i class="bi bi-clock-history me-1"></i>

                                                Active

                                            </span>
                                        }
                                        else if (loan.Status.Equals(
                                            "Completed",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success-subtle text-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Completed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">

                                                @loan.Status

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->
                                    <td class="text-end pe-4">

                                        <a asp-action="Details"
                                           asp-route-id="@loan.LoanId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>

                                            Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>