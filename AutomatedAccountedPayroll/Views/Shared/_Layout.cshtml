@{
    var isAdmin = User.IsInRole("Admin");
    var isEmployee = User.IsInRole("User");
    var isHR = User.IsInRole("HR");
    var isAccountant = User.IsInRole("Accountant");

    string roleLabel = isAdmin ? "Administrator"
        : isHR ? "HR"
        : isAccountant ? "Accountant"
        : isEmployee ? "Employee"
        : "User";

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Automated Accounted Payroll</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/reports.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AutomatedAccountedPayroll.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ui-sizing-fix.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/employee.css"
          asp-append-version="true" />

</head>

<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-wrapper">

            <!-- SIDEBAR -->

            <aside class="app-sidebar">

                <div class="sidebar-brand">

                    <div class="brand-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>

                        <div class="brand-title">
                            Accounted
                        </div>

                        <small>
                            Payroll System
                        </small>

                    </div>

                </div>


                <!-- MENU -->

                <div class="sidebar-menu">

                    @if (isAdmin)
                    {
                        <div class="menu-section">
                            MAIN
                        </div>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">

                            <i class="bi bi-grid-1x2-fill"></i>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        <div class="menu-section">
                            MANAGEMENT
                        </div>


                        <a asp-area=""
                           asp-controller="Employees"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Employees" ? "active" : "")">

                            <i class="bi bi-people-fill"></i>

                            <span>
                                Employees
                            </span>

                        </a>


                        <a asp-controller="Departments"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Departments" ? "active" : "")">

                            <i class="bi bi-diagram-3-fill"></i>

                            <span>
                                Departments
                            </span>

                        </a>


                        <a asp-controller="Designations"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Designations" ? "active" : "")">

                            <i class="bi bi-person-badge-fill"></i>

                            <span>
                                Designations
                            </span>

                        </a>


                        <a asp-controller="Attendances"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Attendances" ? "active" : "")">

                            <i class="bi bi-calendar-check-fill"></i>

                            <span>
                                Attendance
                            </span>

                        </a>


                        <a asp-controller="Leaves"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Leaves" ? "active" : "")">

                            <i class="bi bi-calendar2-week-fill"></i>

                            <span>
                                Leave Management
                            </span>

                        </a>


                        <a asp-controller="Payrolls"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Payrolls" ? "active" : "")">

                            <i class="bi bi-cash-stack"></i>

                            <span>
                                Payroll
                            </span>

                        </a>


                        <div class="sidebar-link reports-menu"
                             id="reportsMenu">

                            <i class="bi bi-bar-chart-line-fill"></i>

                            <span>
                                Reports
                            </span>

                            <i class="bi bi-chevron-down ms-auto reports-arrow"></i>

                        </div>


                        <div class="reports-submenu"
                             id="reportsSubmenu">

                            <a asp-controller="Reports"
                               asp-action="Attendance"
                               class="sidebar-link submenu-link">

                                <i class="bi bi-calendar-check"></i>

                                <span>
                                    Attendance Report
                                </span>

                            </a>


                            <a asp-controller="Reports"
                               asp-action="Payroll"
                               class="sidebar-link submenu-link">

                                <i class="bi bi-cash-stack"></i>

                                <span>
                                    Payroll Report
                                </span>

                            </a>

                        </div>


                        <div class="menu-section">
                            SYSTEM
                        </div>


                        <a asp-controller="Users"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Users" ? "active" : "")">

                            <i class="bi bi-person-lines-fill"></i>

                            <span>
                                Users
                            </span>

                        </a>


                        <a asp-controller="AuditLogs"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "AuditLogs" ? "active" : "")">

                            <i class="bi bi-shield-check"></i>

                            <span>
                                Audit Log
                            </span>

                        </a>


                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="sidebar-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")">

                            <i class="bi bi-shield-check"></i>

                            <span>
                                Privacy
                            </span>

                        </a>
                    }


                                        @if (isHR)
                    {
                        <div class="menu-section">
                            MANAGEMENT
                        </div>
                        <a asp-controller="Employees"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Employees" ? "active" : "")">
                            <i class="bi bi-people-fill"></i>
                            <span>Employees</span>
                        </a>

                        <a asp-controller="Departments"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Departments" ? "active" : "")">
                            <i class="bi bi-diagram-3-fill"></i>
                            <span>Departments</span>
                        </a>

                        <a asp-controller="Designations"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Designations" ? "active" : "")">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>Designations</span>
                        </a>

                        <a asp-controller="Attendances"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Attendances" ? "active" : "")">
                            <i class="bi bi-calendar-check-fill"></i>
                            <span>Attendance</span>
                        </a>
                        <a asp-controller="Leaves"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Leaves" ? "active" : "")">
                            <i class="bi bi-calendar2-week-fill"></i>
                            <span>Leave Management</span>
                        </a>

                        <div class="menu-section">
                            REPORTS
                        </div>

                        <a asp-controller="Reports"
                           asp-action="Attendance"
                           class="sidebar-link submenu-link">
                            <i class="bi bi-calendar-check"></i>
                            <span>Attendance Report</span>
                        </a>
                    

                       
                    }


                                     @if (isAccountant)
                    {
                        <div class="menu-section">
                            ACCOUNTS
                        </div>

                        <a asp-controller="Payrolls"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Payrolls" ? "active" : "")">
                            <i class="bi bi-cash-stack"></i>
                            <span>Payroll</span>
                        </a>

                        <a asp-controller="Loans"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Loans" ? "active" : "")">
                            <i class="bi bi-wallet2"></i>
                            <span>Loans</span>
                        </a>

                        <div class="menu-section">
                            REPORTS
                        </div>

                        <a asp-controller="Reports"
                           asp-action="Payroll"
                           class="sidebar-link submenu-link">
                            <i class="bi bi-cash-stack"></i>
                            <span>Payroll Report</span>
                        </a>
                    }


                    @if (isEmployee)
                    {
                        <div class="menu-section">
                            MAIN
                        </div>


                        <a asp-area="Employee"
                           asp-controller="Dashboard"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">

                            <i class="bi bi-grid-1x2-fill"></i>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        <div class="menu-section">
                            MY ACCOUNT
                        </div>


                        <a asp-area="Employee"
                           asp-controller="Profile"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Profile" ? "active" : "")">

                            <i class="bi bi-person-circle"></i>

                            <span>
                                My Profile
                            </span>

                        </a>


                        <a asp-area="Employee"
                           asp-controller="Attendance"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Attendance" ? "active" : "")">

                            <i class="bi bi-calendar-check-fill"></i>

                            <span>
                                My Attendance
                            </span>

                        </a>


                        <a asp-area="Employee"
                           asp-controller="Leave"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Leave" ? "active" : "")">

                            <i class="bi bi-calendar2-week-fill"></i>

                            <span>
                                My Leaves
                            </span>

                        </a>


                        <a asp-area="Employee"
                           asp-controller="Payroll"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Payroll" ? "active" : "")">

                            <i class="bi bi-cash-stack"></i>

                            <span>
                                My Payroll
                            </span>

                        </a>


                        <a asp-area="Employee"
                           asp-controller="Loan"
                           asp-action="Index"
                           class="sidebar-link @(currentController == "Loan" ? "active" : "")">

                            <i class="bi bi-wallet2"></i>

                            <span>
                                My Loans
                            </span>

                        </a>
                    }

                </div>


                <!-- USER -->

                <div class="sidebar-user">

                    <div class="user-avatar">

                        @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper())

                    </div>

                    <div class="user-info">

                        <div class="user-name">
                            @User.Identity?.Name
                        </div>

                        <small>
                            @roleLabel
                        </small>

                    </div>

                </div>

            </aside>


            <!-- MAIN -->

            <div class="app-main">

                <!-- TOPBAR -->

                <header class="app-topbar">

                    <div class="d-flex align-items-center">

                        <button class="sidebar-toggle"
                                type="button"
                                id="sidebarToggle">

                            <i class="bi bi-list"></i>

                        </button>

                        <span class="topbar-title">
                            @ViewData["Title"]
                        </span>

                    </div>


                    <div class="topbar-actions">

                        <div class="topbar-user">

                            <div class="topbar-avatar">

                                @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper())

                            </div>

                            <div class="d-none d-md-block">

                                <div class="topbar-user-name">
                                    @User.Identity?.Name
                                </div>

                                <small>
                                    @roleLabel
                                </small>

                            </div>

                        </div>


                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              method="post">

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">

                                <i class="bi bi-box-arrow-right me-1"></i>

                                Logout

                            </button>

                        </form>

                    </div>

                </header>


                <!-- CONTENT -->

                <main class="app-content">

                    @RenderBody()

                </main>


                <!-- FOOTER -->

                <footer class="app-footer">

                    <span>
                        © 2026 Automated Accounted Payroll
                    </span>

                    <a asp-controller="Home"
                       asp-action="Privacy">

                        Privacy

                    </a>

                </footer>

            </div>

        </div>
    }
    else
    {
        <!-- PUBLIC NAVBAR -->

        <header>

            <nav class="navbar navbar-expand-lg public-navbar">

                <div class="container">

                    <a class="navbar-brand fw-bold"
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="bi bi-building me-2"></i>

                        Automated Accounted Payroll

                    </a>


                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#publicNavbar">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <div class="collapse navbar-collapse"
                         id="publicNavbar">

                        <ul class="navbar-nav ms-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    Home

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Privacy">

                                    Privacy

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="btn btn-primary ms-lg-2 px-4"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">

                                    Login

                                </a>

                            </li>

                        </ul>

                    </div>

                </div>

            </nav>

        </header>


        <main>

            @RenderBody()

        </main>


        <footer class="app-footer public-footer">

            <div class="container">

                <span>
                    © 2026 Automated Accounted Payroll
                </span>

                <a asp-controller="Home"
                   asp-action="Privacy">

                    Privacy

                </a>

            </div>

        </footer>
    }


    <!-- JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const sidebarToggle =
                document.getElementById("sidebarToggle");

            const body =
                document.body;

            if (sidebarToggle) {

                sidebarToggle.addEventListener("click", function () {

                    body.classList.toggle("sidebar-collapsed");

                });

            }

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>