@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = "Delete User";

    var isDefaultAdmin =
        Model.Email == "Admin.example@gmail.com";
}

<div class="attendance-report-page">

    <div class="report-page-header">

        <div>
            <h1>Delete User</h1>
            <p>Remove a system user account.</p>
        </div>

    </div>


    <div class="row">

        <div class="col-lg-7">

            <div class="report-table-card">

                <div class="report-table-header">

                    <div>
                        <h5>Delete User</h5>
                        <p>Review the account before deleting it.</p>
                    </div>

                </div>


                <div class="p-4">

                    @if (isDefaultAdmin)
                    {
                        <div class="alert alert-warning">

                            <div class="d-flex gap-2">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <div>
                                    <strong>Default Admin Account</strong>

                                    <div class="mt-1">
                                        This account is protected and cannot be deleted.
                                    </div>
                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">

                            <div class="d-flex gap-2">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <div>
                                    <strong>Are you sure?</strong>

                                    <div class="mt-1">
                                        This action will permanently delete this user account.
                                    </div>
                                </div>

                            </div>

                        </div>
                    }


                    <div class="row g-4 mb-4">

                        <!-- EMAIL -->

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Email
                            </div>

                            <div class="fw-semibold">
                                @Model.Email
                            </div>

                        </div>


                        <!-- USERNAME -->

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                Username
                            </div>

                            <div class="fw-semibold">
                                @Model.UserName
                            </div>

                        </div>


                        <!-- USER ID -->

                        <div class="col-12">

                            <div class="text-muted small mb-1">
                                User ID
                            </div>

                            <div class="small text-muted">
                                @Model.Id
                            </div>

                        </div>

                    </div>


                    @if (!isDefaultAdmin)
                    {
                        <form asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash me-1"></i>
                                Delete User

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel

                            </a>

                        </form>
                    }
                    else
                    {
                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Users

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>