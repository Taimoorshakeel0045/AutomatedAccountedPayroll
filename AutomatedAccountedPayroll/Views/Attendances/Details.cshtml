@model AutomatedAccountedPayroll.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";

    var employee = Model.Employee;

    var checkInDisplay = Model.CheckInTime.HasValue
        ? DateTime.Today.Add(Model.CheckInTime.Value).ToString("hh:mm tt")
        : "Not Recorded";

    var checkOutDisplay = Model.CheckOutTime.HasValue
        ? DateTime.Today.Add(Model.CheckOutTime.Value).ToString("hh:mm tt")
        : "Not Recorded";

    var workingHoursDisplay = Model.WorkingHours.HasValue
        ? $"{Model.WorkingHours.Value:0.00} hours"
        : "Not Available";

    var createdAtDisplay = Model.CreatedAt.ToLocalTime()
        .ToString("dd MMMM yyyy, hh:mm tt");
}


<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-1">

                <i class="bi bi-calendar-check text-primary fs-4"></i>

                <h1 class="h3 mb-0">
                    Attendance Details
                </h1>

            </div>

            <p class="text-muted mb-0">
                Review the employee attendance record.
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.AttendanceId"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

        </div>

    </div>


    <div class="row g-4">

        <!-- EMPLOYEE HEADER -->

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex flex-wrap justify-content-between
                                align-items-center gap-3">

                        <div class="d-flex align-items-center gap-3">

                            <div class="rounded-circle bg-primary bg-opacity-10
                                        text-primary d-flex align-items-center
                                        justify-content-center fw-semibold"
                                 style="width:64px;height:64px;font-size:20px;">

                                @if (employee != null)
                                {
                                    @employee.FirstName?.FirstOrDefault()
                                    @employee.LastName?.FirstOrDefault()
                                }
                                else
                                {
                                    <i class="bi bi-person"></i>
                                }

                            </div>


                            <div>

                                @if (employee != null)
                                {
                                    <h4 class="mb-1">
                                        @employee.FirstName @employee.LastName
                                    </h4>

                                    <div class="text-muted">

                                        Employee Code:

                                        <span class="fw-semibold">
                                            @employee.EmployeeCode
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <h4 class="mb-1">
                                        Employee Information Unavailable
                                    </h4>
                                }

                            </div>

                        </div>


                        <div class="text-md-end">

                            <div class="text-muted small mb-1">
                                Attendance Date
                            </div>

                            <div class="fw-semibold fs-5">
                                @Model.AttendanceDate.ToString("dd MMM yyyy")
                            </div>

                            <div class="text-muted small">
                                @Model.AttendanceDate.ToString("dddd")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- STATUS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start">

                        <div>

                            <div class="text-muted small mb-2">
                                Attendance Status
                            </div>

                            @if (Model.Status == "Present")
                            {
                                <span class="badge rounded-pill bg-success px-3 py-2">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Present

                                </span>
                            }
                            else if (Model.Status == "Absent")
                            {
                                <span class="badge rounded-pill bg-danger px-3 py-2">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Absent

                                </span>
                            }
                            else if (Model.Status == "Late")
                            {
                                <span class="badge rounded-pill bg-warning text-dark px-3 py-2">

                                    <i class="bi bi-clock me-1"></i>
                                    Late

                                </span>
                            }
                            else if (Model.Status == "Half Day")
                            {
                                <span class="badge rounded-pill bg-info px-3 py-2">

                                    <i class="bi bi-hourglass-split me-1"></i>
                                    Half Day

                                </span>
                            }
                            else if (Model.Status == "Leave")
                            {
                                <span class="badge rounded-pill bg-secondary px-3 py-2">

                                    <i class="bi bi-calendar-x me-1"></i>
                                    Leave

                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary px-3 py-2">
                                    @Model.Status
                                </span>
                            }

                        </div>


                        <div class="rounded-circle bg-primary bg-opacity-10
                                    text-primary d-flex align-items-center
                                    justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="bi bi-clipboard-check fs-5"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- WORKING HOURS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start">

                        <div>

                            <div class="text-muted small mb-2">
                                Working Hours
                            </div>

                            <div class="fw-semibold fs-4">
                                @workingHoursDisplay
                            </div>

                            <small class="text-muted">
                                Calculated working time
                            </small>

                        </div>


                        <div class="rounded-circle bg-success bg-opacity-10
                                    text-success d-flex align-items-center
                                    justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="bi bi-hourglass-split fs-5"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- LATE MINUTES -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                                align-items-start">

                        <div>

                            <div class="text-muted small mb-2">
                                Late Minutes
                            </div>

                            @if (Model.LateMinutes > 0)
                            {
                                <div class="fw-semibold fs-4 text-warning">
                                    @Model.LateMinutes minutes
                                </div>

                                <small class="text-muted">
                                    Delay after office start time
                                </small>
                            }
                            else
                            {
                                <div class="fw-semibold fs-4">
                                    0 minutes
                                </div>

                                <small class="text-muted">
                                    No late arrival
                                </small>
                            }

                        </div>


                        <div class="rounded-circle bg-warning bg-opacity-10
                                    text-warning d-flex align-items-center
                                    justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="bi bi-clock fs-5"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CHECK IN -->

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-box-arrow-in-right text-success fs-5"></i>

                        <div>

                            <h5 class="mb-0">
                                Check In
                            </h5>

                            <small class="text-muted">
                                Employee arrival time
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body pt-2 pb-4">

                    @if (Model.CheckInTime.HasValue)
                    {
                        <div class="fs-2 fw-semibold text-success">
                            @checkInDisplay
                        </div>

                        <div class="text-muted small">
                            Check-in recorded
                        </div>
                    }
                    else
                    {
                        <div class="fs-5 text-muted">
                            Not Recorded
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- CHECK OUT -->

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-box-arrow-right text-danger fs-5"></i>

                        <div>

                            <h5 class="mb-0">
                                Check Out
                            </h5>

                            <small class="text-muted">
                                Employee departure time
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body pt-2 pb-4">

                    @if (Model.CheckOutTime.HasValue)
                    {
                        <div class="fs-2 fw-semibold text-danger">
                            @checkOutDisplay
                        </div>

                        <div class="text-muted small">
                            Check-out recorded
                        </div>
                    }
                    else
                    {
                        <div class="fs-5 text-muted">
                            Not Recorded
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ATTENDANCE INFORMATION -->

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-info-circle text-primary fs-5"></i>

                        <div>

                            <h5 class="mb-0">
                                Attendance Information
                            </h5>

                            <small class="text-muted">
                                System calculated attendance values
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body">

                    <div class="row g-4">

                        <div class="col-md-4">

                            <div class="text-muted small mb-1">
                                Attendance Status
                            </div>

                            <div class="fw-semibold">
                                @Model.Status
                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="text-muted small mb-1">
                                Working Hours
                            </div>

                            <div class="fw-semibold">
                                @workingHoursDisplay
                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="text-muted small mb-1">
                                Late Minutes
                            </div>

                            <div class="fw-semibold">
                                @Model.LateMinutes minutes
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- REMARKS -->

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-chat-left-text text-primary fs-5"></i>

                        <div>

                            <h5 class="mb-0">
                                Remarks
                            </h5>

                            <small class="text-muted">
                                Additional attendance information
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <div>
                            @Model.Remarks
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">
                            No remarks were added to this attendance record.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- CREATED -->

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Record Created
                    </div>

                    <div class="fw-semibold">
                        @createdAtDisplay
                    </div>

                    <small class="text-muted">
                        Attendance record creation time
                    </small>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="col-12">

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Delete"
                   asp-route-id="@Model.AttendanceId"
                   class="btn btn-outline-danger">

                    <i class="bi bi-trash me-1"></i>
                    Delete

                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.AttendanceId"
                   class="btn btn-primary">

                    <i class="bi bi-pencil me-1"></i>
                    Edit Attendance

                </a>

            </div>

        </div>

    </div>

</div>