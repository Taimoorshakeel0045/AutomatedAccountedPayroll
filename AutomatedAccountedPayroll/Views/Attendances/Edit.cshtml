@model AutomatedAccountedPayroll.Models.Attendance

@{
    ViewData["Title"] = "Edit Attendance";

    var attendanceType = ViewData["AttendanceType"]?.ToString() ?? "Normal";

    if (Model.Status == "Absent")
    {
        attendanceType = "Absent";
    }
    else if (Model.Status == "Leave")
    {
        attendanceType = "Leave";
    }
    else if (Model.Status == "Half Day")
    {
        attendanceType = "Half Day";
    }
    else
    {
        attendanceType = "Normal";
    }
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="badge bg-primary-subtle text-primary px-3 py-2">
                    <i class="bi bi-calendar-check me-1"></i>
                    Attendance
                </span>

            </div>

            <h1 class="h3 fw-bold mb-1">
                Edit Attendance
            </h1>

            <p class="text-muted mb-0">
                Update the attendance record and its working times.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Attendance

        </a>

    </div>


    <form asp-action="Edit"
          method="post"
          id="attendanceForm">

        <input type="hidden"
               asp-for="AttendanceId" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger shadow-sm">
        </div>


        <div class="row g-4">

            <!-- LEFT SIDE -->
            <div class="col-lg-8">

                <!-- ATTENDANCE INFORMATION -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-bottom py-3">

                        <div class="d-flex align-items-center">

                            <div class="bg-primary-subtle text-primary rounded-3 p-2 me-3">
                                <i class="bi bi-person-check fs-5"></i>
                            </div>

                            <div>

                                <h5 class="mb-1 fw-semibold">
                                    Attendance Information
                                </h5>

                                <small class="text-muted">
                                    Update the employee, date and attendance type.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body p-4">

                        <div class="row g-4">

                            <!-- EMPLOYEE -->
                            <div class="col-12">

                                <label asp-for="EmployeeId"
                                       class="form-label fw-semibold">
                                    Employee
                                </label>

                                <select asp-for="EmployeeId"
                                        class="form-select form-select-lg"
                                        asp-items="ViewBag.EmployeeId"
                                        id="employeeSelect">
                                </select>

                                <span asp-validation-for="EmployeeId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- DATE -->
                            <div class="col-md-6">

                                <label asp-for="AttendanceDate"
                                       class="form-label fw-semibold">
                                    Attendance Date
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-calendar3"></i>
                                    </span>

                                    <input asp-for="AttendanceDate"
                                           type="date"
                                           class="form-control"
                                           id="attendanceDate" />

                                </div>

                                <span asp-validation-for="AttendanceDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ATTENDANCE TYPE -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Attendance Type
                                </label>

                                <select name="attendanceType"
                                        id="attendanceType"
                                        class="form-select">

                                    <option value="Normal"
                                            selected="@(attendanceType == "Normal")">
                                        Normal
                                    </option>

                                    <option value="Absent"
                                            selected="@(attendanceType == "Absent")">
                                        Absent
                                    </option>

                                    <option value="Leave"
                                            selected="@(attendanceType == "Leave")">
                                        Leave
                                    </option>

                                    <option value="Half Day"
                                            selected="@(attendanceType == "Half Day")">
                                        Half Day
                                    </option>

                                </select>

                                <div class="form-text">
                                    Normal attendance is automatically marked Present or Late from Check In time.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- WORKING HOURS -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-bottom py-3">

                        <div class="d-flex align-items-center">

                            <div class="bg-success-subtle text-success rounded-3 p-2 me-3">
                                <i class="bi bi-clock fs-5"></i>
                            </div>

                            <div>

                                <h5 class="mb-1 fw-semibold">
                                    Working Hours
                                </h5>

                                <small class="text-muted">
                                    Check In and Check Out are calculated into working hours automatically.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body p-4">

                        <div class="row g-4">

                            <!-- CHECK IN -->
                            <div class="col-md-6">

                                <div class="border rounded-3 p-3 h-100"
                                     id="checkInCard">

                                    <div class="d-flex align-items-center mb-3">

                                        <div class="bg-success-subtle text-success rounded-circle p-2 me-2">
                                            <i class="bi bi-box-arrow-in-right"></i>
                                        </div>

                                        <div>

                                            <label asp-for="CheckInTime"
                                                   class="form-label fw-semibold mb-0">
                                                Check In
                                            </label>

                                            <small class="d-block text-muted">
                                                Employee arrival time
                                            </small>

                                        </div>

                                    </div>

                                    <input asp-for="CheckInTime"
                                           type="time"
                                           class="form-control form-control-lg"
                                           step="60"
                                           id="checkInTime" />

                                    <span asp-validation-for="CheckInTime"
                                          class="text-danger">
                                    </span>

                                    <div class="form-text">
                                        After 08:00, the system marks the attendance Late.
                                    </div>

                                </div>

                            </div>


                            <!-- CHECK OUT -->
                            <div class="col-md-6">

                                <div class="border rounded-3 p-3 h-100"
                                     id="checkOutCard">

                                    <div class="d-flex align-items-center mb-3">

                                        <div class="bg-danger-subtle text-danger rounded-circle p-2 me-2">
                                            <i class="bi bi-box-arrow-right"></i>
                                        </div>

                                        <div>

                                            <label asp-for="CheckOutTime"
                                                   class="form-label fw-semibold mb-0">
                                                Check Out
                                            </label>

                                            <small class="d-block text-muted">
                                                Employee departure time
                                            </small>

                                        </div>

                                    </div>

                                    <input asp-for="CheckOutTime"
                                           type="time"
                                           class="form-control form-control-lg"
                                           step="60"
                                           id="checkOutTime" />

                                    <span asp-validation-for="CheckOutTime"
                                          class="text-danger">
                                    </span>

                                    <div class="form-text">
                                        Check Out is required for Normal and Half Day attendance.
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- AUTOMATIC STATUS -->
                        <div class="mt-4">

                            <div class="alert alert-primary d-flex align-items-start gap-3 mb-0"
                                 id="statusPreview">

                                <i class="bi bi-info-circle-fill fs-5"></i>

                                <div>

                                    <div class="fw-semibold"
                                         id="statusPreviewTitle">
                                        Attendance status
                                    </div>

                                    <div id="statusPreviewText">
                                        Status will be calculated automatically.
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- REMARKS -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-bottom py-3">

                        <div class="d-flex align-items-center">

                            <div class="bg-secondary-subtle text-secondary rounded-3 p-2 me-3">
                                <i class="bi bi-chat-left-text fs-5"></i>
                            </div>

                            <div>

                                <h5 class="mb-1 fw-semibold">
                                    Remarks
                                </h5>

                                <small class="text-muted">
                                    Add or update attendance notes.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body p-4">

                        <label asp-for="Remarks"
                               class="form-label fw-semibold">
                            Attendance Notes
                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter any notes or additional information..."></textarea>

                        <span asp-validation-for="Remarks"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- RIGHT SIDE -->
            <div class="col-lg-4">

                <!-- CURRENT VALUES -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-bottom py-3">

                        <h5 class="mb-0 fw-semibold">
                            Attendance Summary
                        </h5>

                    </div>


                    <div class="card-body p-4">

                        <div class="d-flex align-items-center mb-4">

                            <div class="bg-primary-subtle text-primary rounded-3 p-3 me-3">
                                <i class="bi bi-person fs-4"></i>
                            </div>

                            <div>

                                <div class="small text-muted">
                                    Employee
                                </div>

                                <div class="fw-semibold"
                                     id="summaryEmployee">
                                    Select employee
                                </div>

                            </div>

                        </div>


                        <div class="d-flex align-items-center mb-4">

                            <div class="bg-info-subtle text-info rounded-3 p-3 me-3">
                                <i class="bi bi-calendar-event fs-4"></i>
                            </div>

                            <div>

                                <div class="small text-muted">
                                    Attendance Date
                                </div>

                                <div class="fw-semibold"
                                     id="summaryDate">
                                    Select date
                                </div>

                            </div>

                        </div>


                        <div class="d-flex align-items-center">

                            <div class="bg-success-subtle text-success rounded-3 p-3 me-3">
                                <i class="bi bi-check-circle fs-4"></i>
                            </div>

                            <div>

                                <div class="small text-muted">
                                    Status
                                </div>

                                <div class="fw-semibold"
                                     id="summaryStatus">
                                    @Model.Status
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- EXISTING CALCULATIONS -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-bottom py-3">

                        <h5 class="mb-0 fw-semibold">
                            Calculated Values
                        </h5>

                    </div>

                    <div class="card-body p-4">

                        <div class="mb-3">

                            <div class="small text-muted">
                                Working Hours
                            </div>

                            <div class="fw-semibold"
                                 id="summaryWorkingHours">
                                @(Model.WorkingHours?.ToString("0.00") ?? "Not calculated")
                            </div>

                        </div>


                        <div>

                            <div class="small text-muted">
                                Late Minutes
                            </div>

                            <div class="fw-semibold"
                                 id="summaryLateMinutes">
                                @Model.LateMinutes
                            </div>

                        </div>

                    </div>

                </div>


                <!-- INFORMATION -->
                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="d-flex align-items-start">

                            <div class="text-primary me-3">
                                <i class="bi bi-info-circle fs-4"></i>
                            </div>

                            <div>

                                <h6 class="fw-semibold">
                                    Attendance Guidelines
                                </h6>

                                <ul class="text-muted small mb-0 ps-3">

                                    <li class="mb-2">
                                        Normal attendance is calculated from Check In.
                                    </li>

                                    <li class="mb-2">
                                        Check In after 08:00 becomes Late.
                                    </li>

                                    <li class="mb-2">
                                        Check Out is required for Normal and Half Day.
                                    </li>

                                    <li class="mb-2">
                                        Absent and Leave do not require times.
                                    </li>

                                    <li>
                                        Working Hours and Late Minutes are calculated automatically.
                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="card border-0 shadow-sm mt-4">

            <div class="card-body d-flex flex-column flex-sm-row justify-content-end gap-2 p-3">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-lg me-1"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary px-4">

                    <i class="bi bi-check-lg me-1"></i>
                    Save Changes

                </button>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const attendanceType =
                document.getElementById("attendanceType");

            const checkIn =
                document.getElementById("checkInTime");

            const checkOut =
                document.getElementById("checkOutTime");

            const employee =
                document.getElementById("employeeSelect");

            const date =
                document.getElementById("attendanceDate");

            const summaryEmployee =
                document.getElementById("summaryEmployee");

            const summaryDate =
                document.getElementById("summaryDate");

            const summaryStatus =
                document.getElementById("summaryStatus");

            const summaryWorkingHours =
                document.getElementById("summaryWorkingHours");

            const summaryLateMinutes =
                document.getElementById("summaryLateMinutes");

            const statusPreview =
                document.getElementById("statusPreview");

            const statusPreviewTitle =
                document.getElementById("statusPreviewTitle");

            const statusPreviewText =
                document.getElementById("statusPreviewText");

            const checkInCard =
                document.getElementById("checkInCard");

            const checkOutCard =
                document.getElementById("checkOutCard");


            function calculateStatus() {

                const type = attendanceType.value;

                if (type === "Absent") {
                    return "Absent";
                }

                if (type === "Leave") {
                    return "Leave";
                }

                if (type === "Half Day") {
                    return "Half Day";
                }

                if (!checkIn.value) {
                    return "Present";
                }

                return checkIn.value > "08:00"
                    ? "Late"
                    : "Present";
            }


            function calculateHours() {

                if (!checkIn.value ||
                    !checkOut.value ||
                    attendanceType.value === "Absent" ||
                    attendanceType.value === "Leave") {

                    return null;
                }

                const start =
                    checkIn.value.split(":");

                const end =
                    checkOut.value.split(":");

                const startMinutes =
                    parseInt(start[0]) * 60 +
                    parseInt(start[1]);

                const endMinutes =
                    parseInt(end[0]) * 60 +
                    parseInt(end[1]);

                if (endMinutes < startMinutes) {
                    return null;
                }

                return ((endMinutes - startMinutes) / 60)
                    .toFixed(2);
            }


            function calculateLateMinutes() {

                if (!checkIn.value ||
                    attendanceType.value === "Absent" ||
                    attendanceType.value === "Leave" ||
                    attendanceType.value === "Half Day") {

                    return 0;
                }

                const time =
                    checkIn.value.split(":");

                const minutes =
                    parseInt(time[0]) * 60 +
                    parseInt(time[1]);

                const officeStart =
                    8 * 60;

                return Math.max(
                    0,
                    minutes - officeStart
                );
            }


            function updateTimeControls() {

                const type =
                    attendanceType.value;

                const noTimeRequired =
                    type === "Absent" ||
                    type === "Leave";

                if (noTimeRequired) {

                    checkIn.value = "";
                    checkOut.value = "";

                    checkIn.disabled = true;
                    checkOut.disabled = true;

                    checkIn.required = false;
                    checkOut.required = false;

                    checkInCard.classList.add("bg-light");
                    checkOutCard.classList.add("bg-light");

                }
                else {

                    checkIn.disabled = false;
                    checkOut.disabled = false;

                    checkIn.required = true;
                    checkOut.required = true;

                    checkInCard.classList.remove("bg-light");
                    checkOutCard.classList.remove("bg-light");
                }

                updatePreview();
            }


            function updatePreview() {

                const calculatedStatus =
                    calculateStatus();

                const hours =
                    calculateHours();

                const lateMinutes =
                    calculateLateMinutes();


                summaryStatus.textContent =
                    calculatedStatus;

                summaryWorkingHours.textContent =
                    hours !== null
                        ? hours
                        : "Not calculated";

                summaryLateMinutes.textContent =
                    lateMinutes;


                if (calculatedStatus === "Late") {

                    statusPreview.className =
                        "alert alert-warning d-flex align-items-start gap-3 mb-0";

                    statusPreviewTitle.textContent =
                        "Late attendance";

                    statusPreviewText.textContent =
                        "Check In is after 08:00. The system will save this record as Late.";

                }
                else if (calculatedStatus === "Present") {

                    statusPreview.className =
                        "alert alert-success d-flex align-items-start gap-3 mb-0";

                    statusPreviewTitle.textContent =
                        "Present attendance";

                    statusPreviewText.textContent =
                        "Check In is on time. The system will save this record as Present.";

                }
                else if (calculatedStatus === "Absent") {

                    statusPreview.className =
                        "alert alert-danger d-flex align-items-start gap-3 mb-0";

                    statusPreviewTitle.textContent =
                        "Absent attendance";

                    statusPreviewText.textContent =
                        "Check In and Check Out are disabled.";

                }
                else if (calculatedStatus === "Leave") {

                    statusPreview.className =
                        "alert alert-info d-flex align-items-start gap-3 mb-0";

                    statusPreviewTitle.textContent =
                        "Leave attendance";

                    statusPreviewText.textContent =
                        "Check In and Check Out are disabled.";

                }
                else {

                    statusPreview.className =
                        "alert alert-primary d-flex align-items-start gap-3 mb-0";

                    statusPreviewTitle.textContent =
                        "Half Day attendance";

                    statusPreviewText.textContent =
                        "Check In and Check Out are required.";

                }
            }


            function updateSummary() {

                const selectedOption =
                    employee.options[employee.selectedIndex];

                summaryEmployee.textContent =
                    selectedOption && selectedOption.value
                        ? selectedOption.text
                        : "Select employee";


                if (date.value) {

                    const selectedDate =
                        new Date(date.value + "T00:00:00");

                    summaryDate.textContent =
                        selectedDate.toLocaleDateString(
                            "en-GB",
                            {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                            }
                        );

                }
                else {

                    summaryDate.textContent =
                        "Select date";
                }
            }


            attendanceType.addEventListener(
                "change",
                function () {

                    if (attendanceType.value === "Absent" ||
                        attendanceType.value === "Leave") {

                        checkIn.value = "";
                        checkOut.value = "";
                    }

                    updateTimeControls();
                });


            checkIn.addEventListener(
                "change",
                updatePreview);


            checkOut.addEventListener(
                "change",
                updatePreview);


            employee.addEventListener(
                "change",
                updateSummary);


            date.addEventListener(
                "change",
                updateSummary);


            updateTimeControls();
            updateSummary();

        });
    </script>
}