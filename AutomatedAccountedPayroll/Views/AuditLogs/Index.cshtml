@model IEnumerable<AutomatedAccountedPayroll.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Log";

    var actions = ViewBag.Actions as IEnumerable<string>
        ?? Enumerable.Empty<string>();

    var entityNames = ViewBag.EntityNames as IEnumerable<string>
        ?? Enumerable.Empty<string>();
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Audit Log</h2>
            <p class="text-muted mb-0">
                Track important system changes and administrative activity.
            </p>
        </div>

                <span class="badge text-bg-dark px-3 py-2">
            Latest 500 records — Total in DB: @ViewBag.TotalInDb
        </span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form method="get" class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">User</label>

                    <input name="userName"
                           value="@ViewBag.UserName"
                           class="form-control"
                           placeholder="Email or username"
                           maxlength="256" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Action</label>

                    <select name="action" class="form-select">
                        <option value="">All Actions</option>

                        @foreach (var item in actions)
                        {
                            if (ViewBag.Action == item)
                            {
                                <option value="@item" selected>
                                    @item
                                </option>
                            }
                            else
                            {
                                <option value="@item">
                                    @item
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Entity</label>

                    <select name="entityName" class="form-select">
                        <option value="">All Entities</option>

                        @foreach (var item in entityNames)
                        {
                            if (ViewBag.EntityName == item)
                            {
                                <option value="@item" selected>
                                    @item
                                </option>
                            }
                            else
                            {
                                <option value="@item">
                                    @item
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">From</label>

                    <input type="date"
                           name="fromDate"
                           value="@ViewBag.FromDate"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">To</label>

                    <input type="date"
                           name="toDate"
                           value="@ViewBag.ToDate"
                           class="form-control" />
                </div>

                <div class="col-12 d-flex gap-2">

                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-search me-1"></i>
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Date & Time</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Entity ID</th>
                        <th>IP Address</th>
                        <th class="text-end">Details</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var log in Model)
                    {
                        <tr>

                            <td>
                                @log.Timestamp
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm:ss tt")
                            </td>

                            <td>
                                @(log.UserName ?? "System")
                            </td>

                            <td>

                                @if (log.Action == "Create")
                                {
                                    <span class="badge text-bg-success">
                                        @log.Action
                                    </span>
                                }
                                else if (log.Action == "Delete")
                                {
                                    <span class="badge text-bg-danger">
                                        @log.Action
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-primary">
                                        @log.Action
                                    </span>
                                }

                            </td>

                            <td>
                                @log.EntityName
                            </td>

                            <td>
                                @(log.EntityId ?? "-")
                            </td>

                            <td>
                                @(log.IpAddress ?? "-")
                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@log.AuditLogId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                            </td>

                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center py-5 text-muted">

                                No audit records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>