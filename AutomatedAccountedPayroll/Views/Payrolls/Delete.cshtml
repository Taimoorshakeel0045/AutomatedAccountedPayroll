@model AutomatedAccountedPayroll.Models.Payroll

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Payroll</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Payroll Month
        </dt>
        <dd class="col-sm-10">
            @Model.PayrollMonth.ToString("MMMM yyyy")
        </dd>

        <dt class="col-sm-2">
            Basic Salary
        </dt>
        <dd class="col-sm-10">
            @Model.BasicSalary.ToString("N2")
        </dd>

        <dt class="col-sm-2">
            Allowances
        </dt>
        <dd class="col-sm-10">
            @Model.Allowances.ToString("N2")
        </dd>

        <dt class="col-sm-2">
            Deductions
        </dt>
        <dd class="col-sm-10">
            @Model.Deductions.ToString("N2")
        </dd>

        <dt class="col-sm-2">
            Net Salary
        </dt>
        <dd class="col-sm-10">
            @Model.NetSalary.ToString("N2")
        </dd>

        <dt class="col-sm-2">
            Created At
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
        </dd>

        <dt class="col-sm-2">
            Employee
        </dt>
        <dd class="col-sm-10">
            @if (Model.Employee != null)
            {
                <span>
                    @Model.Employee.EmployeeCode
                </span>
            }
            else
            {
                <span class="text-muted">
                    No employee assigned
                </span>
            }
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="PayrollId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </form>

</div>
