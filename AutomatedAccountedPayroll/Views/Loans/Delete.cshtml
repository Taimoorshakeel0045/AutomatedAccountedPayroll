@model AutomatedAccountedPayroll.Models.Loan

@{
    ViewData["Title"] = "Delete Loan";
}

<div class="attendance-report-page">

    <div class="report-page-header d-flex justify-content-between align-items-center">

        <div>
            <h1>Delete Loan</h1>
            <p>Confirm whether you want to delete this loan record.</p>
        </div>

        <a asp-action="Index"
           class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Loans
        </a>

    </div>


    <div class="report-table-card">

        <div class="report-table-header">
            <div>
                <h5>Confirm Delete</h5>
                <p>This action cannot be undone.</p>
            </div>
        </div>


        <div class="p-4">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Are you sure you want to delete this loan record?
            </div>


            <div class="row g-4">

                <div class="col-md-6">

                    <div class="text-muted small">
                        Employee
                    </div>

                    <div class="fw-semibold mt-1">
                        @Model.Employee?.FirstName
                        @Model.Employee?.LastName
                    </div>

                    <div class="text-muted small">
                        @Model.Employee?.EmployeeCode
                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        Status
                    </div>

                    <div class="mt-1">
                        @if (Model.Status == "Active")
                        {
                            <span class="report-status present">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="report-status absent">
                                @Model.Status
                            </span>
                        }
                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        Loan Amount
                    </div>

                    <div class="fs-5 fw-semibold mt-1">
                        @Model.LoanAmount.ToString("N2")
                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        Remaining Balance
                    </div>

                    <div class="fs-5 fw-semibold mt-1">
                        @Model.RemainingBalance.ToString("N2")
                    </div>

                </div>

            </div>


            <form asp-action="Delete"
                  method="post"
                  class="d-flex justify-content-end gap-2 mt-4">

                <input type="hidden"
                       asp-for="LoanId" />

                <a asp-action="Index"
                   class="btn btn-light">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash me-1"></i>
                    Delete Loan

                </button>

            </form>

        </div>

    </div>

</div>