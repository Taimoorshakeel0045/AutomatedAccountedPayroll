@model AutomatedAccountedPayroll.Models.Loan

@{
    ViewData["Title"] = "Add Loan";
}

<div class="attendance-report-page">

    <div class="report-page-header d-flex justify-content-between align-items-center">

        <div>
            <h1>Add Loan</h1>
            <p>Create a new employee loan record.</p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Loans
            </a>
        </div>

    </div>


    <div class="report-table-card">

        <div class="report-table-header">
            <div>
                <h5>Loan Information</h5>
                <p>Enter the employee loan details below.</p>
            </div>
        </div>


        <div class="p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- Employee -->

                    <div class="col-md-6">

                        <label asp-for="EmployeeId"
                               class="form-label">
                            Employee
                        </label>

                        <select asp-for="EmployeeId"
                                class="form-select">

                            <option value="">
                                Select Employee
                            </option>

                            @foreach (var employee in ViewBag.Employees)
                            {
                                <option value="@employee.EmployeeId">
                                    @employee.FirstName @employee.LastName
                                    - @employee.EmployeeCode
                                </option>
                            }

                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Loan Amount -->

                    <div class="col-md-6">

                        <label asp-for="LoanAmount"
                               class="form-label">
                            Loan Amount
                        </label>

                        <input asp-for="LoanAmount"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01"
                               placeholder="Enter loan amount" />

                        <span asp-validation-for="LoanAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Monthly Installment -->

                    <div class="col-md-6">

                        <label asp-for="MonthlyInstallment"
                               class="form-label">
                            Monthly Installment
                        </label>

                        <input asp-for="MonthlyInstallment"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01"
                               placeholder="Enter monthly installment" />

                        <span asp-validation-for="MonthlyInstallment"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Start Date -->

                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label">
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Remarks -->

                    <div class="col-12">

                        <label asp-for="Remarks"
                               class="form-label">
                            Remarks
                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional remarks about this loan"></textarea>

                        <span asp-validation-for="Remarks"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Information -->

                <div class="alert alert-light border mt-4">

                    <div class="d-flex">

                        <i class="bi bi-info-circle me-2"></i>

                        <div>
                            <strong>Loan Information</strong>

                            <div class="small text-muted mt-1">
                                The remaining balance will automatically
                                start equal to the loan amount.
                            </div>
                        </div>

                    </div>

                </div>


                <!-- Buttons -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-light">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Create Loan

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}