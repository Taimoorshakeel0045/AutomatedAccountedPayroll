@model AutomatedAccountedPayroll.Models.Loan

@{
    ViewData["Title"] = "Edit Loan";
}

<div class="attendance-report-page">

    <div class="report-page-header d-flex justify-content-between align-items-center">

        <div>
            <h1>Edit Loan</h1>
            <p>Update the employee loan information.</p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Loans
            </a>
        </div>

    </div>


    <div class="report-table-card">

        <div class="report-table-header">
            <div>
                <h5>Loan Information</h5>
                <p>Update the details below.</p>
            </div>
        </div>


        <div class="p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden"
                       asp-for="LoanId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- Employee -->

                    <div class="col-md-6">

                        <label asp-for="EmployeeId"
                               class="form-label">
                            Employee
                        </label>

                        <select asp-for="EmployeeId"
                                class="form-select">

                            <option value="">
                                Select Employee
                            </option>

                            @foreach (var employee in ViewBag.Employees)
                            {
                                <option value="@employee.EmployeeId">
                                    @employee.FirstName @employee.LastName
                                    - @employee.EmployeeCode
                                </option>
                            }

                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Loan Amount -->

                    <div class="col-md-6">

                        <label asp-for="LoanAmount"
                               class="form-label">
                            Loan Amount
                        </label>

                        <input asp-for="LoanAmount"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01" />

                        <span asp-validation-for="LoanAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Monthly Installment -->

                    <div class="col-md-6">

                        <label asp-for="MonthlyInstallment"
                               class="form-label">
                            Monthly Installment
                        </label>

                        <input asp-for="MonthlyInstallment"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01" />

                        <span asp-validation-for="MonthlyInstallment"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Start Date -->

                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label">
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Status -->

                    <div class="col-md-6">

                        <label asp-for="Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Remaining Balance -->

                    <div class="col-md-6">

                        <label asp-for="RemainingBalance"
                               class="form-label">
                            Remaining Balance
                        </label>

                        <input asp-for="RemainingBalance"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />

                        <span asp-validation-for="RemainingBalance"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Remarks -->

                    <div class="col-12">

                        <label asp-for="Remarks"
                               class="form-label">
                            Remarks
                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="4"></textarea>

                        <span asp-validation-for="Remarks"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-light">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}