@model AutomatedAccountedPayroll.Models.Loan

@{
    ViewData["Title"] = "Loan Details";

    decimal totalPaid = ViewBag.TotalPaid ?? 0;
    int paymentCount = ViewBag.PaymentCount ?? 0;

    var payments =
        ViewBag.Payments as IEnumerable<AutomatedAccountedPayroll.Models.LoanPayment>
        ?? Enumerable.Empty<AutomatedAccountedPayroll.Models.LoanPayment>();
}

<div class="attendance-report-page">

    <div class="report-page-header d-flex justify-content-between align-items-center">

        <div>
            <h1>Loan Details</h1>
            <p>View complete information about this employee loan.</p>
        </div>

        <div class="d-flex gap-2">

            @if (Model.Status == "Active" && Model.RemainingBalance > 0)
            {
                <a asp-controller="LoanPayments"
                   asp-action="Create"
                   asp-route-loanId="@Model.LoanId"
                   class="btn btn-success btn-sm">

                    <i class="bi bi-plus-lg me-1"></i>
                    Add Payment

                </a>
            }

            @if (Model.Status != "Paid")
            {


                <a asp-action="AddPayment"
                   asp-route-id="@Model.LoanId"
                   class="btn btn-success">
                    <i class="bi bi-cash-stack me-1"></i>
                    Add Payment
                </a>
                <a asp-action="Edit"
                   asp-route-id="@Model.LoanId"
                   class="btn btn-primary btn-sm">

                    <i class="bi bi-pencil me-1"></i>
                    Edit Loan

                </a>
            }

            <a asp-action="Index"
               class="btn btn-light btn-sm">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Loans

            </a>

        </div>

    </div>


    <!-- Summary Cards -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Loan Amount
                    </div>

                    <div class="fs-4 fw-bold mt-2">
                        @Model.LoanAmount.ToString("N2")
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Paid
                    </div>

                    <div class="fs-4 fw-bold mt-2">
                        @totalPaid.ToString("N2")
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Remaining Balance
                    </div>

                    <div class="fs-4 fw-bold mt-2">
                        @Model.RemainingBalance.ToString("N2")
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Payments Made
                    </div>

                    <div class="fs-4 fw-bold mt-2">
                        @paymentCount
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Loan Information -->

    <div class="report-table-card mb-4">

        <div class="report-table-header">

            <div>
                <h5>Loan Information</h5>
                <p>Loan #@Model.LoanId</p>
            </div>

        </div>


        <div class="p-4">

            <div class="row g-4">

                <!-- Employee -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Employee
                    </div>

                    <div class="fw-semibold mt-1">
                        @Model.Employee?.FirstName
                        @Model.Employee?.LastName
                    </div>

                    <div class="text-muted small">
                        @Model.Employee?.EmployeeCode
                    </div>

                </div>


                <!-- Status -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Status
                    </div>

                    <div class="mt-1">

                        @if (Model.Status == "Active")
                        {
                            <span class="report-status present">
                                Active
                            </span>
                        }
                        else if (Model.Status == "Completed")
                        {
                            <span class="report-status present">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="report-status absent">
                                @Model.Status
                            </span>
                        }

                    </div>

                </div>


                <!-- Loan Amount -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Loan Amount
                    </div>

                    <div class="fs-5 fw-semibold mt-1">
                        @Model.LoanAmount.ToString("N2")
                    </div>

                </div>


                <!-- Monthly Installment -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Monthly Installment
                    </div>

                    <div class="fs-5 fw-semibold mt-1">
                        @Model.MonthlyInstallment.ToString("N2")
                    </div>

                </div>


                <!-- Remaining Balance -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Remaining Balance
                    </div>

                    <div class="fs-5 fw-semibold mt-1">
                        @Model.RemainingBalance.ToString("N2")
                    </div>

                </div>


                <!-- Start Date -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Start Date
                    </div>

                    <div class="fw-semibold mt-1">
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <!-- Created At -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Created At
                    </div>

                    <div class="fw-semibold mt-1">
                        @Model.CreatedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy hh:mm tt")
                    </div>

                </div>


                <!-- Remarks -->

                <div class="col-12">

                    <div class="text-muted small">
                        Remarks
                    </div>

                    <div class="mt-1">

                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                            ? "No remarks provided."
                            : Model.Remarks)

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Payment History -->

    <div class="report-table-card">

        <div class="report-table-header d-flex justify-content-between align-items-center">

            <div>
                <h5>Payment History</h5>

                <p>
                    @paymentCount payment(s) recorded
                </p>
            </div>

            <a asp-controller="LoanPayments"
               asp-action="Index"
               asp-route-loanId="@Model.LoanId"
               class="btn btn-outline-primary btn-sm">

                <i class="bi bi-receipt me-1"></i>
                View All Payments

            </a>

        </div>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>
                            Payment Date
                        </th>

                        <th>
                            Payment Amount
                        </th>

                        <th>
                            Remaining Balance
                        </th>

                        <th>
                            Payment Method
                        </th>

                        <th>
                            Remarks
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (payments.Any())
                    {
                        foreach (var payment in payments.Take(5))
                        {
                            <tr>

                                <td>
                                    @payment.PaymentDate
                                        .ToString("dd MMM yyyy")
                                </td>

                                <td class="fw-semibold">
                                    @payment.PaymentAmount
                                        .ToString("N2")
                                </td>

                                <td>
                                    @payment.RemainingBalance
                                        .ToString("N2")
                                </td>

                                <td>
                                    @payment.PaymentMethod
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(payment.Remarks)
                                        ? "-"
                                        : payment.Remarks)
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bi bi-receipt fs-2 d-block mb-2"></i>

                                    No payments have been recorded.

                                </div>

                                @if (Model.Status == "Active" &&
                                     Model.RemainingBalance > 0)
                                {
                                    <a asp-controller="LoanPayments"
                                       asp-action="Create"
                                       asp-route-loanId="@Model.LoanId"
                                       class="btn btn-primary btn-sm mt-3">

                                        Add First Payment

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>