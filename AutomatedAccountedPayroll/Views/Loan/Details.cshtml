@model AutomatedAccountedPayroll.Models.Loan

@{
    ViewData["Title"] = "Loan Details";

    var payments = ViewBag.Payments
        as IEnumerable<AutomatedAccountedPayroll.Models.LoanPayment>
        ?? Enumerable.Empty<AutomatedAccountedPayroll.Models.LoanPayment>();

    var totalPaid = ViewBag.TotalPaid is decimal
        ? (decimal)ViewBag.TotalPaid
        : 0;

    var paymentCount = ViewBag.PaymentCount is int
        ? (int)ViewBag.PaymentCount
        : 0;

    decimal progress = Model.LoanAmount > 0
        ? (totalPaid / Model.LoanAmount) * 100
        : 0;

    progress = Math.Max(0, Math.Min(100, progress));
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Loan Details
            </h2>

            <p class="text-muted mb-0">
                View loan information and payment history.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.LoanId"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Loan
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Loans
            </a>

        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Loan Amount
                    </div>

                    <div class="fs-4 fw-bold">
                        Rs. @Model.LoanAmount.ToString("N0")
                    </div>

                    <small class="text-muted">
                        Original loan amount
                    </small>

                </div>

            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Total Paid
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        Rs. @totalPaid.ToString("N0")
                    </div>

                    <small class="text-muted">
                        Total recorded payments
                    </small>

                </div>

            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Remaining Balance
                    </div>

                    <div class="fs-4 fw-bold
                        @(Model.RemainingBalance > 0
                            ? "text-danger"
                            : "text-success")">

                        Rs. @Model.RemainingBalance.ToString("N0")

                    </div>

                    <small class="text-muted">
                        Outstanding amount
                    </small>

                </div>

            </div>
        </div>


        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Payments
                    </div>

                    <div class="fs-4 fw-bold">
                        @paymentCount
                    </div>

                    <small class="text-muted">
                        Recorded payments
                    </small>

                </div>

            </div>
        </div>

    </div>


    <!-- PAYMENT PROGRESS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-2">

                <div>
                    <h6 class="fw-semibold mb-1">
                        Loan Repayment Progress
                    </h6>

                    <small class="text-muted">
                        Amount paid against the original loan
                    </small>
                </div>

                <span class="fw-bold text-success">
                    @progress.ToString("0")%
                </span>

            </div>

            <div class="progress"
                 style="height: 10px;">

                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: @progress.ToString("0.##")%;"
                     aria-valuenow="@progress.ToString("0.##")"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>

            </div>

        </div>

    </div>


    <!-- LOAN INFORMATION -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center">

                <div class="bg-primary-subtle text-primary rounded-3 p-2 me-3">
                    <i class="bi bi-wallet2 fs-5"></i>
                </div>

                <div>

                    <h5 class="mb-1 fw-semibold">
                        Loan Information
                    </h5>

                    <small class="text-muted">
                        Complete information about this loan.
                    </small>

                </div>

            </div>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- EMPLOYEE -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Employee
                    </div>

                    <div class="fw-semibold">
                        @(Model.Employee == null
                            ? "N/A"
                            : $"{Model.Employee.FirstName} {Model.Employee.LastName}")
                    </div>

                </div>


                <!-- EMPLOYEE CODE -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Employee Code
                    </div>

                    <div class="fw-semibold">
                        @(Model.Employee?.EmployeeCode ?? "N/A")
                    </div>

                </div>


                <!-- LOAN AMOUNT -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Loan Amount
                    </div>

                    <div class="fw-semibold">
                        Rs. @Model.LoanAmount.ToString("N2")
                    </div>

                </div>


                <!-- MONTHLY INSTALLMENT -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Monthly Installment
                    </div>

                    <div class="fw-semibold">
                        Rs. @Model.MonthlyInstallment.ToString("N2")
                    </div>

                </div>


                <!-- START DATE -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Start Date
                    </div>

                    <div class="fw-semibold">
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <!-- STATUS -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Status
                    </div>

                    <div>

                        @if (Model.Status.Equals(
                            "Active",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-primary-subtle text-primary">

                                <i class="bi bi-clock-history me-1"></i>
                                Active

                            </span>
                        }
                        else if (Model.Status.Equals(
                            "Completed",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success-subtle text-success">

                                <i class="bi bi-check-circle me-1"></i>
                                Completed

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">
                                @Model.Status
                            </span>
                        }

                    </div>

                </div>


                <!-- REMAINING BALANCE -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Remaining Balance
                    </div>

                    <div class="fw-semibold
                        @(Model.RemainingBalance > 0
                            ? "text-danger"
                            : "text-success")">

                        Rs. @Model.RemainingBalance.ToString("N2")

                    </div>

                </div>


                <!-- CREATED DATE -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Created At
                    </div>

                    <div class="fw-semibold">
                        @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                    </div>

                </div>


                <!-- REMARKS -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Remarks
                    </div>

                    <div class="fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                            ? "No remarks"
                            : Model.Remarks)

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PAYMENT HISTORY -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center">

                <div class="bg-success-subtle text-success rounded-3 p-2 me-3">
                    <i class="bi bi-receipt fs-5"></i>
                </div>

                <div>

                    <h5 class="mb-1 fw-semibold">
                        Payment History
                    </h5>

                    <small class="text-muted">
                        All payments recorded against this loan.
                    </small>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!payments.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-receipt fs-1 text-muted"></i>
                    </div>

                    <h5 class="fw-semibold">
                        No Payments Recorded
                    </h5>

                    <p class="text-muted mb-0">
                        No payment records have been added for this loan yet.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Payment Date
                                </th>

                                <th>
                                    Payment Amount
                                </th>

                                <th>
                                    Payment Method
                                </th>

                                <th>
                                    Remaining Balance
                                </th>

                                <th>
                                    Remarks
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var payment in payments)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <span class="fw-semibold">
                                            @payment.PaymentDate.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <td>

                                        <span class="fw-semibold text-success">
                                            Rs. @payment.PaymentAmount.ToString("N2")
                                        </span>

                                    </td>


                                    <td>

                                        @payment.PaymentMethod

                                    </td>


                                    <td>

                                        <span class="fw-semibold
                                            @(payment.RemainingBalance > 0
                                                ? "text-danger"
                                                : "text-success")">

                                            Rs. @payment.RemainingBalance.ToString("N2")

                                        </span>

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(payment.Remarks))
                                        {
                                            @payment.Remarks
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>