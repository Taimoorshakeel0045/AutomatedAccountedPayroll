@model AutomatedAccountedPayroll.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container-fluid py-4">

    
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">Create Employee</h1>
            <p class="text-muted mb-0">
                Add a new employee to the payroll system.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Employees
        </a>

    </div>


    <form asp-action="Create">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <!-- Personal Information -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-1">
                    Personal Information
                </h5>

                <small class="text-muted">
                    Basic information about the employee
                </small>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">

                        <label asp-for="EmployeeCode"
                               class="form-label">
                        </label>

                        <input asp-for="EmployeeCode"
                               class="form-control"
                               placeholder="EMP-001" />

                        <span asp-validation-for="EmployeeCode"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="FirstName"
                               class="form-label">
                        </label>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="First name" />

                        <span asp-validation-for="FirstName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="LastName"
                               class="form-label">
                        </label>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Last name" />

                        <span asp-validation-for="LastName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="FatherName"
                               class="form-label">
                        </label>

                        <input asp-for="FatherName"
                               class="form-control"
                               placeholder="Father name" />

                        <span asp-validation-for="FatherName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="CNIC"
                               class="form-label">
                        </label>

                        <input asp-for="CNIC"
                               class="form-control"
                               placeholder="xxxxx-xxxxxxx-x" />

                        <span asp-validation-for="CNIC"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Contact Information -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-1">
                    Contact Information
                </h5>

                <small class="text-muted">
                    Employee contact and address details
                </small>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Phone"
                               class="form-label">
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="03xx-xxxxxxx" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="employee@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12">

                        <label asp-for="Address"
                               class="form-label">
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Complete residential address">
                    </textarea>

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Employment Information -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-1">
                    Employment Information
                </h5>

                <small class="text-muted">
                    Department, designation and joining details
                </small>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">

                        <label asp-for="JoiningDate"
                               class="form-label">
                        </label>

                        <input asp-for="JoiningDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="JoiningDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="DepartmentId"
                               class="form-label">
                        </label>

                        <select asp-for="DepartmentId"
                                class="form-select"
                                asp-items="ViewBag.DepartmentId"
                                id="DepartmentId">

                            <option value="">
                                Select Department
                            </option>

                        </select>

                        <span asp-validation-for="DepartmentId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="DesignationId"
                               class="form-label">
                        </label>

                        <select asp-for="DesignationId"
                                class="form-select"
                                id="DesignationId"
                                disabled>

                            <option value="">
                                Select Department First
                            </option>

                        </select>

                        <span asp-validation-for="DesignationId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="EmploymentType"
                               class="form-label">
                        </label>

                        <select asp-for="EmploymentType"
                                class="form-select">

                            <option value="">
                                Select Employment Type
                            </option>

                            <option value="Full Time">
                                Full Time
                            </option>

                            <option value="Part Time">
                                Part Time
                            </option>

                            <option value="Contract">
                                Contract
                            </option>

                        </select>

                        <span asp-validation-for="EmploymentType"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="BasicSalary"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                Rs.
                            </span>

                            <input asp-for="BasicSalary"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="50000" />

                        </div>

                        <span asp-validation-for="BasicSalary"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4 d-flex align-items-end">

                        <div class="form-check mb-2">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   id="IsActive" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active Employee
                            </label>

                        </div>

                    </div>

                </div>

            </div>

        </div>


                <!-- OPTIONAL LOGIN ACCOUNT -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-1">
                    Login Account (Optional)
                </h5>

                <small class="text-muted">
                    Create a login account for this employee in the same step.
                    Leave unchecked to create the account later.
                </small>

            </div>

            <div class="card-body">

                <div class="form-check mb-3">

                    <input type="checkbox"
                           id="createLogin"
                           name="createLogin"
                           value="true"
                           class="form-check-input" />

                    <label class="form-check-label fw-semibold"
                           for="createLogin">
                        Create login account now
                    </label>

                </div>

                <div id="loginFields"
                     class="row g-3"
                     style="display:none;">

                    <div class="col-md-6">

                        <label for="loginEmail"
                               class="form-label">
                            Login Email
                        </label>

                        <input type="email"
                               id="loginEmail"
                               name="loginEmail"
                               class="form-control"
                               placeholder="employee@example.com" />

                        <span class="text-danger small"
                              data-valmsg-for="loginEmail">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label for="loginPassword"
                               class="form-label">
                            Login Password
                        </label>

                        <input type="password"
                               id="loginPassword"
                               name="loginPassword"
                               class="form-control"
                               placeholder="Minimum 6 characters with a digit" />

                        <span class="text-danger small"
                              data-valmsg-for="loginPassword">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Form Actions -->

        <div class="d-flex justify-content-end gap-2 mb-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary px-4">
                Create Employee
            </button>

        </div>

    </form>
    

</div>

@section Scripts {

    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.getElementById("DepartmentId")
            .addEventListener("change", function () {

                const departmentId = this.value;

                const designationDropdown =
                    document.getElementById("DesignationId");


                designationDropdown.innerHTML =
                    '<option value="">Loading designations...</option>';

                designationDropdown.disabled = true;


                if (!departmentId) {

                    designationDropdown.innerHTML =
                        '<option value="">Select Department First</option>';

                    return;
                }


                fetch(
                    '@Url.Action("GetDesignations", "Employees")?departmentId='
                    + departmentId
                )
                .then(response => response.json())
                .then(data => {

                    designationDropdown.innerHTML =
                        '<option value="">Select Designation</option>';


                    if (data.length === 0) {

                        designationDropdown.innerHTML =
                            '<option value="">No designations available</option>';

                        designationDropdown.disabled = true;

                        return;
                    }


                    data.forEach(function (designation) {

                        const option =
                            document.createElement("option");

                        option.value = designation.id;

                        option.textContent = designation.name;

                        designationDropdown.appendChild(option);

                    });


                    designationDropdown.disabled = false;

                })
                .catch(error => {

                    console.error(
                        "Error loading designations:",
                        error
                    );

                    designationDropdown.innerHTML =
                        '<option value="">Error loading designations</option>';

                    designationDropdown.disabled = true;

                });

            });

    </script>
  

}
