
@model AutomatedAccountedPayroll.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">Employee Details</h1>

            <p class="text-muted mb-0">
                View complete employee information.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.EmployeeId"
               class="btn btn-primary">
                Edit Employee
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Employees
            </a>

        </div>

    </div>


    <!-- Employee Header -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="mb-1">
                        @Model.FirstName @Model.LastName
                    </h2>

                    <p class="text-muted mb-2">
                        Employee Code:
                        <strong>@Model.EmployeeCode</strong>
                    </p>

                    @if (Model.Department != null)
                    {
                        <span class="text-muted">
                            @Model.Department.DepartmentName
                        </span>
                    }

                    @if (Model.Designation != null)
                    {
                        <span class="text-muted">
                            |
                            @Model.Designation.DesignationName
                        </span>
                    }

                </div>


                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6 px-3 py-2">
                            Inactive
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">


        <!-- Personal Information -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Personal Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Employee Code
                        </div>

                        <div class="col-sm-7">
                            <strong>@Model.EmployeeCode</strong>
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            First Name
                        </div>

                        <div class="col-sm-7">
                            @Model.FirstName
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Last Name
                        </div>

                        <div class="col-sm-7">
                            @Model.LastName
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Father Name
                        </div>

                        <div class="col-sm-7">
                            @Model.FatherName
                        </div>

                    </div>


                    <div class="row">

                        <div class="col-sm-5 text-muted">
                            CNIC
                        </div>

                        <div class="col-sm-7">
                            @Model.CNIC
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Contact Information -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Contact Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Phone
                        </div>

                        <div class="col-sm-8">
                            @Model.Phone
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Email
                        </div>

                        <div class="col-sm-8">
                            @Model.Email
                        </div>

                    </div>


                    <div class="row">

                        <div class="col-sm-4 text-muted">
                            Address
                        </div>

                        <div class="col-sm-8">
                            @Model.Address
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Employment Information -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Employment Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Department
                        </div>

                        <div class="col-sm-7">

                            @if (Model.Department != null)
                            {
                                <strong>
                                    @Model.Department.DepartmentName
                                </strong>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Assigned
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Designation
                        </div>

                        <div class="col-sm-7">

                            @if (Model.Designation != null)
                            {
                                <strong>
                                    @Model.Designation.DesignationName
                                </strong>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Assigned
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-5 text-muted">
                            Joining Date
                        </div>

                        <div class="col-sm-7">
                            @Model.JoiningDate.ToString("dd-MM-yyyy")
                        </div>

                    </div>


                    <div class="row">

                        <div class="col-sm-5 text-muted">
                            Employment Type
                        </div>

                        <div class="col-sm-7">
                            @Model.EmploymentType
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Salary Information -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Salary Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-sm-6 text-muted">
                            Basic Salary
                        </div>

                        <div class="col-sm-6">

                            <strong>
                                @Model.BasicSalary.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <div class="row">

                        <div class="col-sm-6 text-muted">
                            Employee Status
                        </div>

                        <div class="col-sm-6">

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- System Information -->

        <div class="col-12">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        System Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">

                            <span class="text-muted">
                                Employee ID
                            </span>

                            <div>
                                <strong>
                                    @Model.EmployeeId
                                </strong>
                            </div>

                        </div>


                        <div class="col-md-4">

                            <span class="text-muted">
                                Created At
                            </span>

                            <div>
                                <strong>
                                    @Model.CreatedAt.ToString("dd-MM-yyyy hh:mm tt")
                                </strong>
                            </div>

                        </div>


                        <div class="col-md-4">

                            <span class="text-muted">
                                Current Status
                            </span>

                            <div>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Bottom Actions -->

    <div class="mt-4 mb-4">

        <a asp-action="Edit"
           asp-route-id="@Model.EmployeeId"
           class="btn btn-primary">
            Edit Employee
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.EmployeeId"
           class="btn btn-outline-danger ms-2">
            Delete Employee
        </a>

        <a asp-action="Index"
           class="btn btn-secondary ms-2">
            Back to Employees
        </a>

    </div>

</div>

