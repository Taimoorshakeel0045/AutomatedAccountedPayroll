    /* =========================================================
           EMPLOYEE STATUS
           ========================================================= */

    .status-block {
        margin-bottom: 26px;
    }

        .status-block:last-child {
            margin-bottom: 0;
        }

    .status-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 9px;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }

    .status-green {
        color: #16a34a;
    }

    .status-red {
        color: #dc2626;
    }

    .dashboard-progress {
        width: 100%;
        height: 9px;
        background: #eef2f7;
        border-radius: 20px;
        overflow: hidden;
    }

    .dashboard-progress-bar {
        height: 100%;
        min-width: 0;
        border-radius: 20px;
        transition: width 0.5s ease;
    }

    .progress-green {
        background: #16a34a;
    }

    .progress-red {
        background: #dc2626;
    }

    .status-card {
        width: 100%;
        min-height: 76px;
        padding: 14px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-card-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .status-green-bg {
        background: rgba(22, 163, 74, 0.10);
        color: #16a34a;
    }

    .status-red-bg {
        background: rgba(220, 38, 38, 0.10);
        color: #dc2626;
    }

    .status-card span {
        display: block;
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 3px;
    }

    .status-card strong {
        display: block;
        color: #111827;
        font-size: 17px;
    }

    /* =========================================================
           QUICK ACTIONS
           ========================================================= */

    .quick-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .quick-action {
        width: 100%;
        min-height: 68px;
        padding: 11px 13px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #111827;
        transition: all 0.2s ease;
    }

        .quick-action:hover {
            background: #f8fafc;
            border-color: #bfdbfe;
            color: #111827;
            transform: translateX(3px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

    .quick-action-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .quick-purple {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .quick-burgundy {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .quick-beige {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    .quick-green {
        background: rgba(22, 163, 74, 0.10);
        color: #16a34a;
    }

    .quick-action-content {
        flex: 1;
        min-width: 0;
    }

        .quick-action-content strong {
            display: block;
            color: #1f2937;
            font-size: 13px;
            margin-bottom: 2px;
        }

        .quick-action-content span {
            display: block;
            color: #9ca3af;
            font-size: 11px;
        }

    .quick-arrow {
        color: #9ca3af;
        font-size: 13px;
        transition: transform 0.2s ease;
    }

    .quick-action:hover .quick-arrow {
        transform: translateX(3px);
        color: #2563eb;
    }

    /* =========================================================
           SYSTEM CARDS
           ========================================================= */

    .system-card {
        width: 100%;
        min-height: 190px;
        height: 100%;
        padding: 24px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
