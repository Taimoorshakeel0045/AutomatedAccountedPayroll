            color: #9ca3af;
            font-size: 12px;
        }

    .panel-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .panel-icon-gold {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    .dashboard-panel-body {
        padding: 24px 22px;
