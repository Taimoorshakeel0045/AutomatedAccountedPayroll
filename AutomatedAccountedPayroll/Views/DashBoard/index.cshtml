
@{
    ViewData["Title"] = "Dashboard";

    var totalEmployees = ViewBag.TotalEmployees ?? 0;
    var activeEmployees = ViewBag.ActiveEmployees ?? 0;
    var inactiveEmployees = ViewBag.InactiveEmployees ?? 0;
    var totalDepartments = ViewBag.TotalDepartments ?? 0;
    var totalDesignations = ViewBag.TotalDesignations ?? 0;

    var employeeRate = totalEmployees > 0
        ? Math.Round((double)activeEmployees / totalEmployees * 100, 1)
        : 0;

    var inactiveRate = totalEmployees > 0
        ? Math.Round((double)inactiveEmployees / totalEmployees * 100, 1)
        : 0;
}

<div class="dashboard-page">

    <!-- Header -->
    <div class="dashboard-header">

        <div>
            <div class="dashboard-title-row">
                <div class="dashboard-title-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>

                <div>
                    <h1>Dashboard</h1>
                    <p>Overview of your accounting and payroll system.</p>
                </div>
            </div>
        </div>

        <a asp-controller="Employees"
           asp-action="Create"
           class="dashboard-primary-btn">

            <i class="bi bi-person-plus me-1"></i>
            Add Employee

        </a>

    </div>


    <!-- KPI CARDS -->
    <div class="row g-4 mb-4">

        <!-- Total Employees -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Total Employees
                    </span>

                    <h2>
                        @totalEmployees
                    </h2>

                    <span class="kpi-description">
                        Registered employees
                    </span>
                </div>

                <div class="kpi-icon kpi-purple">
                    <i class="bi bi-people-fill"></i>
                </div>

            </div>

        </div>


        <!-- Active Employees -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Active Employees
                    </span>

                    <h2 class="kpi-success">
                        @activeEmployees
                    </h2>

                    <span class="kpi-description kpi-success-text">
                        @employeeRate% active
                    </span>
                </div>

                <div class="kpi-icon kpi-green">
                    <i class="bi bi-person-check-fill"></i>
                </div>

            </div>

        </div>


        <!-- Departments -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Departments
                    </span>

                    <h2>
                        @totalDepartments
                    </h2>

                    <span class="kpi-description">
                        Company departments
                    </span>
                </div>

                <div class="kpi-icon kpi-burgundy">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>

            </div>

        </div>


        <!-- Designations -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Designations
                    </span>

                    <h2>
                        @totalDesignations
                    </h2>

                    <span class="kpi-description">
                        Employee positions
                    </span>
                </div>

                <div class="kpi-icon kpi-beige">
                    <i class="bi bi-person-badge-fill"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- MAIN DASHBOARD -->
    <div class="row g-4 mb-4">

        <!-- Employee Overview -->
        <div class="col-lg-7">

            <div class="dashboard-panel h-100">

                <div class="dashboard-panel-header">

                    <div>
                        <h5>Employee Overview</h5>

                        <span>
                            Current employee status
                        </span>
                    </div>

                    <div class="panel-icon">
                        <i class="bi bi-people"></i>
                    </div>

                </div>


                <div class="dashboard-panel-body">

                    <!-- Active -->
                    <div class="status-block">

                        <div class="status-heading">

                            <span>
                                Active Employees
                            </span>

                            <strong class="status-green">
                                @activeEmployees
                            </strong>

                        </div>

                        <div class="dashboard-progress">

                            <div class="dashboard-progress-bar progress-green"
                                 style="width:@employeeRate%;">
                            </div>

                        </div>

                    </div>


                    <!-- Inactive -->
                    <div class="status-block">

                        <div class="status-heading">

                            <span>
                                Inactive Employees
                            </span>

                            <strong class="status-red">
                                @inactiveEmployees
                            </strong>

                        </div>

                        <div class="dashboard-progress">

                            <div class="dashboard-progress-bar progress-red"
                                 style="width:@inactiveRate%;">
                            </div>

                        </div>

                    </div>


                    <!-- Status boxes -->
                    <div class="row g-3 mt-4">

                        <div class="col-sm-6">

                            <div class="status-card">

                                <div class="status-card-icon status-green-bg">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div>
                                    <span>Active</span>
                                    <strong>@activeEmployees</strong>
                                </div>

                            </div>

                        </div>


                        <div class="col-sm-6">

                            <div class="status-card">

                                <div class="status-card-icon status-red-bg">
                                    <i class="bi bi-x-lg"></i>
                                </div>

                                <div>
                                    <span>Inactive</span>
                                    <strong>@inactiveEmployees</strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-lg-5">

            <div class="dashboard-panel h-100">

                <div class="dashboard-panel-header">

                    <div>
                        <h5>Quick Actions</h5>

                        <span>
                            Common management tasks
                        </span>
                    </div>

                    <div class="panel-icon panel-icon-gold">
                        <i class="bi bi-lightning-charge"></i>
                    </div>

                </div>


                <div class="dashboard-panel-body">

                    <div class="quick-actions">


                        <a asp-controller="Employees"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-purple">
                                <i class="bi bi-person-plus"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Add Employee
                                </strong>

                                <span>
                                    Create a new employee record
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <a asp-controller="Departments"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-burgundy">
                                <i class="bi bi-diagram-3"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Add Department
                                </strong>

                                <span>
                                    Create a company department
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <a asp-controller="Designations"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-beige">
                                <i class="bi bi-person-badge"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Add Designation
                                </strong>

                                <span>
                                    Create an employee position
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <a asp-controller="Attendances"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-green">
                                <i class="bi bi-calendar-check"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Mark Attendance
                                </strong>

                                <span>
                                    Record employee attendance
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>




<!-- TODAY'S ATTENDANCE -->
<div class="row g-4 mb-4">

    <div class="col-12">

        <div class="dashboard-panel attendance-summary-panel">

            <div class="dashboard-panel-header">

                <div>


                       <h5>Today's Attendance</h5>
                        <span>
                            Employee attendance summary for today
                        </span>
                    </div>

                    <a asp-controller="Attendances"
                       asp-action="Index"
                       class="dashboard-section-link">
                        View All
                        <i class="bi bi-arrow-right"></i>
                    </a>



                <div class="panel-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

            </div>


            <div class="dashboard-panel-body">

                <div class="row g-3">

                    <!-- Present -->
                    <div class="col-6 col-md">
                        <div class="attendance-summary-card attendance-present">

                            <div class="attendance-summary-icon">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>
                                <span>Present</span>
                                <strong>@(ViewBag.TodayPresent ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Absent -->
                    <div class="col-6 col-md">
                        <div class="attendance-summary-card attendance-absent">

                            <div class="attendance-summary-icon">
                                <i class="bi bi-x-lg"></i>
                            </div>

                            <div>
                                <span>Absent</span>
                                <strong>@(ViewBag.TodayAbsent ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Late -->
                    <div class="col-6 col-md">
                        <div class="attendance-summary-card attendance-late">

                            <div class="attendance-summary-icon">
                                <i class="bi bi-clock"></i>
                            </div>

                            <div>
                                <span>Late</span>
                                <strong>@(ViewBag.TodayLate ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Leave -->
                    <div class="col-6 col-md">
                        <div class="attendance-summary-card attendance-leave">

                            <div class="attendance-summary-icon">
                                <i class="bi bi-calendar-minus"></i>
                            </div>

                            <div>
                                <span>Leave</span>
                                <strong>@(ViewBag.TodayLeave ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Half Day -->
                    <div class="col-6 col-md">
                        <div class="attendance-summary-card attendance-halfday">

                            <div class="attendance-summary-icon">
                                <i class="bi bi-hourglass-split"></i>
                            </div>

                            <div>
                                <span>Half Day</span>
                                <strong>@(ViewBag.TodayHalfDay ?? 0)</strong>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- LEAVE SUMMARY -->
<div class="row g-4 mb-4">

    <div class="col-12">

        <div class="dashboard-panel leave-summary-panel">

            <div class="dashboard-panel-header">

    <div>
        <h5>Leave Summary</h5>
        <span>Current leave request overview</span>
    </div>

    <div class="d-flex align-items-center gap-3">

        <a asp-controller="Leaves"
           asp-action="Index"
           class="dashboard-section-link">
            View All
            <i class="bi bi-arrow-right"></i>
        </a>

        <div class="panel-icon">
            <i class="bi bi-calendar2-week"></i>
        </div>

    </div>

</div>

           

            <div class="dashboard-panel-body">

                <div class="row g-3">

                    <!-- Approved -->
                    <div class="col-6 col-md-3">
                        <div class="leave-summary-card leave-approved">

                            <div class="leave-summary-icon">
                                <i class="bi bi-check-circle"></i>
                            </div>

                            <div>
                                <span>Approved</span>
                                <strong>@(ViewBag.ApprovedLeaves ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Pending -->
                    <div class="col-6 col-md-3">
                        <div class="leave-summary-card leave-pending">

                            <div class="leave-summary-icon">
                                <i class="bi bi-hourglass-split"></i>
                            </div>

                            <div>
                                <span>Pending</span>
                                <strong>@(ViewBag.PendingLeaves ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Rejected -->
                    <div class="col-6 col-md-3">
                        <div class="leave-summary-card leave-rejected">

                            <div class="leave-summary-icon">
                                <i class="bi bi-x-circle"></i>
                            </div>

                            <div>
                                <span>Rejected</span>
                                <strong>@(ViewBag.RejectedLeaves ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Total -->
                    <div class="col-6 col-md-3">
                        <div class="leave-summary-card leave-total">

                            <div class="leave-summary-icon">
                                <i class="bi bi-calendar-check"></i>
                            </div>

                            <div>
                                <span>Total Requests</span>
                                <strong>@(ViewBag.TotalLeaveRequests ?? 0)</strong>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>








<!-- PAYROLL SUMMARY -->
<div class="row g-4 mb-4">

    <div class="col-12">

        <div class="dashboard-panel payroll-summary-panel">

            <div class="dashboard-panel-header">

                <div>
                    <h5>Payroll Summary</h5>
                    <span>Overview of salary records and payments</span>
                </div>

                <div class="panel-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

            </div>

            <div class="dashboard-panel-body">

                <div class="row g-3">

                    <!-- Payroll Records -->
                    <div class="col-6 col-md-3">
                        <div class="payroll-summary-card payroll-records">

                            <div class="payroll-summary-icon">
                                <i class="bi bi-receipt"></i>
                            </div>

                            <div>
                                <span>Payroll Records</span>
                                <strong>@(ViewBag.TotalPayrollRecords ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Paid -->
                    <div class="col-6 col-md-3">
                        <div class="payroll-summary-card payroll-paid">

                            <div class="payroll-summary-icon">
                                <i class="bi bi-check-circle"></i>
                            </div>

                            <div>
                                <span>Paid</span>
                                <strong>@(ViewBag.PaidPayroll ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Pending -->
                    <div class="col-6 col-md-3">
                        <div class="payroll-summary-card payroll-pending">

                            <div class="payroll-summary-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div>
                                <span>Pending</span>
                                <strong>@(ViewBag.PendingPayroll ?? 0)</strong>
                            </div>

                        </div>
                    </div>


                    <!-- Net Salary -->
                    <div class="col-6 col-md-3">
                        <div class="payroll-summary-card payroll-salary">

                            <div class="payroll-summary-icon">
                                <i class="bi bi-wallet2"></i>
                            </div>

                            <div>
                                <span>Total Net Salary</span>
                                <strong>
                                    Rs. @String.Format("{0:N0}", ViewBag.TotalNetSalary ?? 0)
                                </strong>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>







<!-- RECENT PAYROLL ACTIVITY -->
<div class="row g-4 mb-4">

    <div class="col-12">

        <div class="dashboard-panel recent-payroll-panel">

            <div class="dashboard-panel-header">

                <div>
                    <h5>Recent Payroll Activity</h5>
                    <span>Latest payroll records</span>
                </div>

                <div class="panel-icon">
                    <i class="bi bi-receipt"></i>
                </div>

            </div>

            <div class="dashboard-panel-body p-0">

                @{
                    var recentPayrolls =
                        ViewBag.RecentPayrolls
                        as List<AutomatedAccountedPayroll.Models.Payroll>;
                }

                @if (recentPayrolls != null && recentPayrolls.Any())
                {
                    <div class="table-responsive">

                        <table class="table recent-payroll-table mb-0">

                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Payroll Month</th>
                                    <th>Net Salary</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var payroll in recentPayrolls)
                                {
                                    <tr>

                                        <td>
                                            <div class="recent-payroll-employee">

                                                <div class="recent-payroll-avatar">
                                                    <i class="bi bi-person"></i>
                                                </div>

                                                <div>
                                                    <strong>
                                                        @(payroll.Employee?.FirstName ?? "")
                                                        @(payroll.Employee?.LastName ?? "")
                                                    </strong>

                                                    <span>
                                                        Employee ID: @payroll.EmployeeId
                                                    </span>
                                                </div>

                                            </div>
                                        </td>

                                        <td>
                                            @payroll.PayrollMonth.ToString("MMMM yyyy")
                                        </td>

                                        <td>
                                            <strong>
                                                Rs. @payroll.NetSalary.ToString("N0")
                                            </strong>
                                        </td>

                                        <td>
                                            @{
                                                var statusClass =
                                                    payroll.Status switch
                                                    {
                                                        "Paid" => "payroll-status-paid",
                                                        "Processed" => "payroll-status-processed",
                                                        _ => "payroll-status-draft"
                                                    };
                                            }

                                            <span class="payroll-status @statusClass">
                                                @payroll.Status
                                            </span>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="recent-payroll-empty">

                        <div class="recent-payroll-empty-icon">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <strong>No payroll records yet</strong>

                        <span>
                            Recent payroll activity will appear here.
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>

</div>






<!-- SYSTEM OVERVIEW -->






    <!-- SYSTEM OVERVIEW -->
    <div class="row g-4">

        <!-- Departments -->
        <div class="col-md-6">

            <div class="system-card">

                <div class="system-icon system-burgundy">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>

                <div class="system-content">

                    <span>
                        Organization
                    </span>

                    <h4>
                        @totalDepartments Departments
                    </h4>

                    <p>
                        Manage your company structure
                    </p>

                </div>

                <a asp-controller="Departments"
                   asp-action="Index"
                   class="system-button">

                    Manage Departments
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>


        <!-- Designations -->
        <div class="col-md-6">

            <div class="system-card">

                <div class="system-icon system-beige">
                    <i class="bi bi-person-badge-fill"></i>
                </div>

                <div class="system-content">

                    <span>
                        Positions
                    </span>

                    <h4>
                        @totalDesignations Designations
                    </h4>

                    <p>
                        Manage employee positions
                    </p>

                </div>

                <a asp-controller="Designations"
                   asp-action="Index"
                   class="system-button">

                    Manage Designations
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</div>


<style>
    /* =========================================================
           DASHBOARD
           ========================================================= */

    .dashboard-page {
        width: 100%;
        max-width: 100%;
        padding: 4px 2px 20px;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .dashboard-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .dashboard-title-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .dashboard-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .dashboard-header p {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .dashboard-primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 8px;
        background: #2563eb;
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid #2563eb;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .dashboard-primary-btn:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(37, 99, 235, 0.20);
        }

    /* =========================================================
           KPI CARDS
           ========================================================= */

    .dashboard-page .row {
        width: 100%;
    }

    .dashboard-kpi {
        width: 100%;
        min-height: 150px;
        height: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
    }

        .dashboard-kpi:hover {
            transform: translateY(-3px);
            border-color: #dbe3f0;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
        }

    .kpi-label {
        display: block;
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .dashboard-kpi h2 {
        color: #111827;
        font-size: 30px;
        line-height: 1;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .kpi-description {
        color: #9ca3af;
        font-size: 12px;
    }

    .kpi-success {
        color: #16a34a !important;
    }

    .kpi-success-text {
        color: #16a34a !important;
    }

    .kpi-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .kpi-purple {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .kpi-green {
        background: rgba(22, 163, 74, 0.10);
        color: #16a34a;
    }

    .kpi-burgundy {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .kpi-beige {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    /* =========================================================
           MAIN PANELS
           ========================================================= */

    .dashboard-panel {
        width: 100%;
        min-height: 390px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        transition: box-shadow 0.2s ease;
    }

        .dashboard-panel:hover {
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
