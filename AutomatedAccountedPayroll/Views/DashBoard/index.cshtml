
@{
    ViewData["Title"] = "Dashboard";

    var totalEmployees = ViewBag.TotalEmployees ?? 0;
    var activeEmployees = ViewBag.ActiveEmployees ?? 0;
    var inactiveEmployees = ViewBag.InactiveEmployees ?? 0;
    var totalDepartments = ViewBag.TotalDepartments ?? 0;
    var totalDesignations = ViewBag.TotalDesignations ?? 0;

    var employeeRate = totalEmployees > 0
        ? Math.Round((double)activeEmployees / totalEmployees * 100, 1)
        : 0;

    var inactiveRate = totalEmployees > 0
        ? Math.Round((double)inactiveEmployees / totalEmployees * 100, 1)
        : 0;
}

<div class="dashboard-page">

    <!-- Header -->
    <div class="dashboard-header">

        <div>
            <div class="dashboard-title-row">
                <div class="dashboard-title-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>

                <div>
                    <h1>Dashboard</h1>
                    <p>Overview of your accounting and payroll system.</p>
                </div>
            </div>
        </div>

        <a asp-controller="Employees"
           asp-action="Create"
           class="dashboard-primary-btn">

            <i class="bi bi-person-plus me-1"></i>
            Add Employee

        </a>

    </div>


    <!-- KPI CARDS -->
    <div class="row g-4 mb-4">

        <!-- Total Employees -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Total Employees
                    </span>

                    <h2>
                        @totalEmployees
                    </h2>

                    <span class="kpi-description">
                        Registered employees
                    </span>
                </div>

                <div class="kpi-icon kpi-purple">
                    <i class="bi bi-people-fill"></i>
                </div>

            </div>

        </div>


        <!-- Active Employees -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Active Employees
                    </span>

                    <h2 class="kpi-success">
                        @activeEmployees
                    </h2>

                    <span class="kpi-description kpi-success-text">
                        @employeeRate% active
                    </span>
                </div>

                <div class="kpi-icon kpi-green">
                    <i class="bi bi-person-check-fill"></i>
                </div>

            </div>

        </div>


        <!-- Departments -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Departments
                    </span>

                    <h2>
                        @totalDepartments
                    </h2>

                    <span class="kpi-description">
                        Company departments
                    </span>
                </div>

                <div class="kpi-icon kpi-burgundy">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>

            </div>

        </div>


        <!-- Designations -->
        <div class="col-sm-6 col-xl-3">

            <div class="dashboard-kpi">

                <div>
                    <span class="kpi-label">
                        Designations
                    </span>

                    <h2>
                        @totalDesignations
                    </h2>

                    <span class="kpi-description">
                        Employee positions
                    </span>
                </div>

                <div class="kpi-icon kpi-beige">
                    <i class="bi bi-person-badge-fill"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- MAIN DASHBOARD -->
    <div class="row g-4 mb-4">

        <!-- Employee Overview -->
        <div class="col-lg-7">

            <div class="dashboard-panel h-100">

                <div class="dashboard-panel-header">

                    <div>
                        <h5>Employee Overview</h5>

                        <span>
                            Current employee status
                        </span>
                    </div>

                    <div class="panel-icon">
                        <i class="bi bi-people"></i>
                    </div>

                </div>


                <div class="dashboard-panel-body">

                    <!-- Active -->
                    <div class="status-block">

                        <div class="status-heading">

                            <span>
                                Active Employees
                            </span>

                            <strong class="status-green">
                                @activeEmployees
                            </strong>

                        </div>

                        <div class="dashboard-progress">

                            <div class="dashboard-progress-bar progress-green"
                                 style="width:@employeeRate%;">
                            </div>

                        </div>

                    </div>


                    <!-- Inactive -->
                    <div class="status-block">

                        <div class="status-heading">

                            <span>
                                Inactive Employees
                            </span>

                            <strong class="status-red">
                                @inactiveEmployees
                            </strong>

                        </div>

                        <div class="dashboard-progress">

                            <div class="dashboard-progress-bar progress-red"
                                 style="width:@inactiveRate%;">
                            </div>

                        </div>

                    </div>


                    <!-- Status boxes -->
                    <div class="row g-3 mt-4">

                        <div class="col-sm-6">

                            <div class="status-card">

                                <div class="status-card-icon status-green-bg">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div>
                                    <span>Active</span>
                                    <strong>@activeEmployees</strong>
                                </div>

                            </div>

                        </div>


                        <div class="col-sm-6">

                            <div class="status-card">

                                <div class="status-card-icon status-red-bg">
                                    <i class="bi bi-x-lg"></i>
                                </div>

                                <div>
                                    <span>Inactive</span>
                                    <strong>@inactiveEmployees</strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-lg-5">

            <div class="dashboard-panel h-100">

                <div class="dashboard-panel-header">

                    <div>
                        <h5>Quick Actions</h5>

                        <span>
                            Common management tasks
                        </span>
                    </div>

                    <div class="panel-icon panel-icon-gold">
                        <i class="bi bi-lightning-charge"></i>
                    </div>

                </div>


                <div class="dashboard-panel-body">

                    <div class="quick-actions">


                        <a asp-controller="Employees"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-purple">
                                <i class="bi bi-person-plus"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Add Employee
                                </strong>

                                <span>
                                    Create a new employee record
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <a asp-controller="Departments"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-burgundy">
                                <i class="bi bi-diagram-3"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Add Department
                                </strong>

                                <span>
                                    Create a company department
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <a asp-controller="Designations"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-beige">
                                <i class="bi bi-person-badge"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Add Designation
                                </strong>

                                <span>
                                    Create an employee position
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>


                        <a asp-controller="Attendances"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon quick-green">
                                <i class="bi bi-calendar-check"></i>
                            </div>

                            <div class="quick-action-content">

                                <strong>
                                    Mark Attendance
                                </strong>

                                <span>
                                    Record employee attendance
                                </span>

                            </div>

                            <i class="bi bi-chevron-right quick-arrow"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- SYSTEM OVERVIEW -->
    <div class="row g-4">

        <!-- Departments -->
        <div class="col-md-6">

            <div class="system-card">

                <div class="system-icon system-burgundy">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>

                <div class="system-content">

                    <span>
                        Organization
                    </span>

                    <h4>
                        @totalDepartments Departments
                    </h4>

                    <p>
                        Manage your company structure
                    </p>

                </div>

                <a asp-controller="Departments"
                   asp-action="Index"
                   class="system-button">

                    Manage Departments
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>


        <!-- Designations -->
        <div class="col-md-6">

            <div class="system-card">

                <div class="system-icon system-beige">
                    <i class="bi bi-person-badge-fill"></i>
                </div>

                <div class="system-content">

                    <span>
                        Positions
                    </span>

                    <h4>
                        @totalDesignations Designations
                    </h4>

                    <p>
                        Manage employee positions
                    </p>

                </div>

                <a asp-controller="Designations"
                   asp-action="Index"
                   class="system-button">

                    Manage Designations
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</div>


<style>
    /* =========================================================
           DASHBOARD
           ========================================================= */

    .dashboard-page {
        width: 100%;
        max-width: 100%;
        padding: 4px 2px 20px;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .dashboard-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .dashboard-title-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .dashboard-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .dashboard-header p {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .dashboard-primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 8px;
        background: #2563eb;
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid #2563eb;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .dashboard-primary-btn:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(37, 99, 235, 0.20);
        }

    /* =========================================================
           KPI CARDS
           ========================================================= */

    .dashboard-page .row {
        width: 100%;
    }

    .dashboard-kpi {
        width: 100%;
        min-height: 150px;
        height: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
    }

        .dashboard-kpi:hover {
            transform: translateY(-3px);
            border-color: #dbe3f0;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
        }

    .kpi-label {
        display: block;
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .dashboard-kpi h2 {
        color: #111827;
        font-size: 30px;
        line-height: 1;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .kpi-description {
        color: #9ca3af;
        font-size: 12px;
    }

    .kpi-success {
        color: #16a34a !important;
    }

    .kpi-success-text {
        color: #16a34a !important;
    }

    .kpi-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .kpi-purple {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .kpi-green {
        background: rgba(22, 163, 74, 0.10);
        color: #16a34a;
    }

    .kpi-burgundy {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .kpi-beige {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    /* =========================================================
           MAIN PANELS
           ========================================================= */

    .dashboard-panel {
        width: 100%;
        min-height: 390px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        transition: box-shadow 0.2s ease;
    }

        .dashboard-panel:hover {
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
        }

    .dashboard-panel-header {
        min-height: 76px;
        padding: 18px 22px;
        border-bottom: 1px solid #eef0f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

        .dashboard-panel-header h5 {
            color: #111827;
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .dashboard-panel-header span {
            color: #9ca3af;
            font-size: 12px;
        }

    .panel-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .panel-icon-gold {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    .dashboard-panel-body {
        padding: 24px 22px;
    }

    /* =========================================================
           EMPLOYEE STATUS
           ========================================================= */

    .status-block {
        margin-bottom: 26px;
    }

        .status-block:last-child {
            margin-bottom: 0;
        }

    .status-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 9px;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }

    .status-green {
        color: #16a34a;
    }

    .status-red {
        color: #dc2626;
    }

    .dashboard-progress {
        width: 100%;
        height: 9px;
        background: #eef2f7;
        border-radius: 20px;
        overflow: hidden;
    }

    .dashboard-progress-bar {
        height: 100%;
        min-width: 0;
        border-radius: 20px;
        transition: width 0.5s ease;
    }

    .progress-green {
        background: #16a34a;
    }

    .progress-red {
        background: #dc2626;
    }

    .status-card {
        width: 100%;
        min-height: 76px;
        padding: 14px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-card-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .status-green-bg {
        background: rgba(22, 163, 74, 0.10);
        color: #16a34a;
    }

    .status-red-bg {
        background: rgba(220, 38, 38, 0.10);
        color: #dc2626;
    }

    .status-card span {
        display: block;
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 3px;
    }

    .status-card strong {
        display: block;
        color: #111827;
        font-size: 17px;
    }

    /* =========================================================
           QUICK ACTIONS
           ========================================================= */

    .quick-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .quick-action {
        width: 100%;
        min-height: 68px;
        padding: 11px 13px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #111827;
        transition: all 0.2s ease;
    }

        .quick-action:hover {
            background: #f8fafc;
            border-color: #bfdbfe;
            color: #111827;
            transform: translateX(3px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

    .quick-action-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .quick-purple {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .quick-burgundy {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .quick-beige {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    .quick-green {
        background: rgba(22, 163, 74, 0.10);
        color: #16a34a;
    }

    .quick-action-content {
        flex: 1;
        min-width: 0;
    }

        .quick-action-content strong {
            display: block;
            color: #1f2937;
            font-size: 13px;
            margin-bottom: 2px;
        }

        .quick-action-content span {
            display: block;
            color: #9ca3af;
            font-size: 11px;
        }

    .quick-arrow {
        color: #9ca3af;
        font-size: 13px;
        transition: transform 0.2s ease;
    }

    .quick-action:hover .quick-arrow {
        transform: translateX(3px);
        color: #2563eb;
    }

    /* =========================================================
           SYSTEM CARDS
           ========================================================= */

    .system-card {
        width: 100%;
        min-height: 190px;
        height: 100%;
        padding: 24px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 18px;
        transition: all 0.2s ease;
    }

        .system-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
            border-color: #dbe3f0;
        }

    .system-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .system-burgundy {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .system-beige {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    .system-content {
        min-width: 0;
    }

        .system-content > span {
            display: block;
            color: #9ca3af;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .system-content h4 {
            color: #111827;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 5px;
        }

        .system-content p {
            color: #6b7280;
            font-size: 12px;
            margin: 0;
        }

    .system-button {
        min-height: 40px;
        padding: 0 14px;
        border: 1px solid #2563eb;
        border-radius: 8px;
        color: #2563eb;
        background: #ffffff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .system-button:hover {
            background: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

    /* =========================================================
           LARGE SCREENS
           ========================================================= */

    @@media (min-width: 1200px) {

        .dashboard-page {
            padding-left: 6px;
            padding-right: 6px;
        }

            .dashboard-page > .row {
                margin-left: -10px;
                margin-right: -10px;
            }

                .dashboard-page > .row > [class*="col-"] {
                    padding-left: 10px;
                    padding-right: 10px;
                }

        .dashboard-kpi {
            min-height: 160px;
            padding: 24px;
        }

        .dashboard-panel {
            min-height: 410px;
        }

        .system-card {
            min-height: 205px;
            padding: 28px;
        }
    }

    /* =========================================================
           LAPTOP
           ========================================================= */

    @@media (max-width: 1199.98px) {

        .dashboard-kpi {
            min-height: 145px;
        }

        .system-card {
            padding: 20px;
        }
    }

    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 991.98px) {

        .dashboard-header {
            align-items: flex-start;
        }

        .dashboard-panel {
            min-height: auto;
        }

        .system-card {
            grid-template-columns: auto 1fr;
        }

        .system-button {
            grid-column: 1 / -1;
            width: 100%;
            justify-content: center;
        }
    }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767.98px) {

        .dashboard-page {
            padding: 0 0 15px;
        }

        .dashboard-header {
            flex-direction: column;
            align-items: stretch;
            margin-bottom: 22px;
        }

        .dashboard-primary-btn {
            width: 100%;
        }

        .dashboard-header h1 {
            font-size: 24px;
        }

        .dashboard-kpi {
            min-height: 135px;
            padding: 18px;
        }

            .dashboard-kpi h2 {
                font-size: 27px;
            }

        .dashboard-panel-header {
            padding: 16px;
        }

        .dashboard-panel-body {
            padding: 18px 16px;
        }

        .system-card {
            min-height: 170px;
            padding: 20px;
        }
    }

    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 575.98px) {

        .dashboard-title-row {
            gap: 10px;
        }

        .dashboard-title-icon {
            width: 42px;
            height: 42px;
            font-size: 18px;
        }

        .dashboard-header h1 {
            font-size: 21px;
        }

        .dashboard-header p {
            font-size: 12px;
        }

        .dashboard-kpi {
            min-height: 125px;
